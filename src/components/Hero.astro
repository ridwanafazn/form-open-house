---
import { eventConfig } from '../config/event';
import { content } from '../config/content';

const words = content.home.hero.title.split(' ');
---

<section class="hero" id="hero">
  <div class="container hero__inner">
    <h1 class="hero__title">
      {words.map((word, i) => (
        <span class="hero__word" style={`--i:${i}`}>{word}</span>
      ))}
    </h1>
    <p class="hero__tagline">{content.home.hero.tagline}</p>
    <p class="hero__info">{eventConfig.dateText}, {eventConfig.startTime} sampai {eventConfig.endTime} WIB, Jalancagak, Subang. Gratis.</p>
    <a class="button button--primary hero__cta" href="#form">{content.home.hero.cta}</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(620px, calc(100vh - 88px));
    display: grid;
    align-items: center;
    margin-inline: var(--space-4);
    padding-block: clamp(72px, 12vw, 144px);
    border: 1px solid var(--teal-dark);
    border-radius: 24px;
    background: var(--teal-pale);
    overflow: hidden;
  }

  .hero::before,
  .hero::after {
    position: absolute;
    content: '';
    pointer-events: none;
    border: 1px solid rgba(15, 111, 106, 0.22);
    border-radius: 50%;
  }

  .hero::before {
    width: 360px;
    height: 360px;
    right: -130px;
    top: -120px;
  }

  .hero::after {
    width: 220px;
    height: 220px;
    right: 80px;
    bottom: -140px;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }
  .hero__title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 8vw, 4rem);
    line-height: 1.05;
    margin: 0;
  }
  .hero__word {
    display: inline-block;
    overflow: hidden;
    margin-right: 0.25em;
    opacity: 0;
    transform: translateY(12px);
    animation: word-in 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    animation-delay: calc(var(--i) * 60ms);
  }
  @keyframes word-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .hero__tagline {
    font-size: 1.25rem;
    margin-block: var(--space-4);
  }
  .hero__info {
    color: var(--ink-soft);
    margin-block: 0 var(--space-6);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__word {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

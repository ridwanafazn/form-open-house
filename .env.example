# Environment variables for the Open House application.
# Copy this file to .env and fill in local values. Never commit .env.

# Public site URL. Local: http://localhost:4321. Production: Workers URL.
PUBLIC_SITE_URL=

# Supabase connection. Server-only values must never enter the browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase connection for the admin page; protected by RLS.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Optional Meta Pixel ID. Leave empty to disable Meta script loading.
PUBLIC_META_PIXEL_ID=

# Fonnte device token for server-side WhatsApp sending. Never use PUBLIC_ prefix.
FONNTE_API_TOKEN=

# Open or close registration.
REGISTRATION_OPEN=true

# Fail build if replacement text [ISI: remains in configuration.
FAIL_ON_PLACEHOLDER=

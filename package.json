{
  "name": "open-house-form",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-pages.mjs",
    "prebuild": "rm -rf .wrangler && node scripts/check-placeholders.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.1",
    "@astrojs/react": "^7.1.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "astro": "^7.4.1",
    "motion": "^14.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

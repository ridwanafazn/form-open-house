---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StorySection from '../components/StorySection';
import AddCalendar from '../components/AddCalendar';
// Form kini tanpa pemeriksaan CAPTCHA (Turnstile). Jebakan bot tetap ada di
// form lewat isian tersembunyi (honeypot), ditangani di sisi server.
import RegisterForm from '../components/RegisterForm';
import { content } from '../config/content';
import { eventConfig } from '../config/event';
import 'leaflet/dist/leaflet.css';
---

<Base>
  <main>
    <Hero />

    <section class="section" id="story" aria-labelledby="story-title">
      <div class="container">
        <header class="section-head">
          <h2 id="story-title">Apa yang bisa dilihat dan dicoba</h2>
        </header>
        <!-- StorySection sudah di-SSR Astro, jadi konten tampil tanpa JS.
             Tidak ada lagi salinan statis terpisah: dahulu dua daftar (statis
             + island) ikut ter-render sehingga nomor 01-04 muncul dua kali
             dan salinan kedua baru muncul saat island terhidrasi. -->
        <StorySection client:visible />
      </div>
    </section>

    <section class="section section--card" id="incentiv" aria-labelledby="incentiv-title">
      <div class="container">
        <header class="section-head">
          <h2 id="incentiv-title">{content.home.incentive.heading}</h2>
        </header>

        <div class="price-grid">
          <div class="price-card">
            <p class="price-card__label">Pendaftaran normal</p>
            <p class="price-card__amount price-card__amount--muted">Rp500<span>ribu</span></p>
            <p class="price-card__note">Di luar open house</p>
          </div>
          <div class="price-card price-card--teal">
            <p class="price-card__label">Daftar saat open house</p>
            <p class="price-card__amount">Rp100<span>ribu</span></p>
            <p class="price-card__note">Hemat Rp400 ribu</p>
          </div>
          <div class="price-card price-card--gold">
            <p class="price-card__label">Daftar belakangan</p>
            <p class="price-card__amount">Rp300<span>ribu</span></p>
            <p class="price-card__note">{content.home.incentive.laterNote}</p>
          </div>
        </div>
        <p class="note">{content.home.incentive.note}</p>
      </div>
    </section>

    <section class="section" id="event-info" aria-labelledby="event-info-title">
      <div class="container">
        <header class="section-head">
          <h2 id="event-info-title">{eventConfig.name}</h2>
        </header>

        <div class="info-grid">
          <div class="info-panel">
            <ul class="info-list">
              <li><strong>Hari dan tanggal</strong> {eventConfig.dateText}</li>
              <li><strong>Jam</strong> {eventConfig.startTime} sampai {eventConfig.endTime} WIB</li>
              <li><strong>Tempat</strong> {eventConfig.locationName}</li>
              <li><strong>Alamat</strong> {eventConfig.locationAddress}</li>
            </ul>
            <div class="info-actions">
              <a class="button button--primary" href={eventConfig.mapsUrl} rel="noopener" target="_blank">{content.home.eventInfo.openMap}</a>
              <AddCalendar client:visible />
            </div>
          </div>
          <div class="map-card">
            <div id="map" class="map-card__canvas" role="application" aria-label={`Peta lokasi ${eventConfig.locationName}`}></div>
            <noscript>
              <p class="map-card__fallback">
                Peta tidak dapat dimuat tanpa JavaScript.
                <a href={eventConfig.mapsUrl} rel="noopener" target="_blank">Buka di Google Maps</a>.
              </p>
            </noscript>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--card" id="rundown" aria-labelledby="rundown-title">
      <div class="container">
        <header class="section-head">
          <h2 id="rundown-title">{content.home.rundown.heading}</h2>
          <p class="section-head__tagline">{content.home.rundown.tagline}</p>
        </header>
        <ol class="rundown-list" role="list">
          {content.home.rundown.items.map((item) => (
            <li class="rundown-item">
              <div class="rundown-time">{item.time}</div>
              <div class="rundown-content">
                <h3 class="rundown-item-title">{item.title}</h3>
                <p class="rundown-item-desc">{item.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" id="form" aria-labelledby="form-title">
      <div class="container form-wrap">
        <header class="section-head">
          <h2 id="form-title">{content.home.form.heading}</h2>
          <p class="section-head__tagline">{content.home.form.tagline}</p>
        </header>
        <RegisterForm client:visible />
      </div>
    </section>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div>
          <p class="site-footer__eyebrow">SMKIT As Syifa Boarding School</p>
          <p>{content.home.footer.text}</p>
        </div>
        <div class="site-footer__actions">
          <a
            class="button button--primary"
            href={`https://wa.me/${eventConfig.admissionWhatsApp}?text=${encodeURIComponent('Assalamualaikum. Saya ingin bertanya tentang Open House SMKIT As Syifa.')}`}
            rel="noopener"
            target="_blank"
          >{content.home.footer.cta}</a>
          <a class="site-footer__legal" href="/privasi">Kebijakan privasi</a>
        </div>
      </div>
    </footer>
  </main>

  <a class="sticky-cta" href="#form">{content.home.hero.cta}</a>
</Base>

<script>
  // Peta Leaflet: inisialisasi malas saat bagian peta pertama kali terlihat,
  // supaya tidak membebani pemuatan awal halaman.
  import L from 'leaflet';
  import { eventConfig } from '../config/event';

  const container = document.getElementById('map');
  if (container) {
    const init = () => {
      const map = L.map(container, {
        scrollWheelZoom: false,
        attributionControl: true,
      }).setView([eventConfig.mapsLat, eventConfig.mapsLng], 15);

      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);

      const marker = L.circleMarker([eventConfig.mapsLat, eventConfig.mapsLng], {
        radius: 10,
        color: '#0f6f6a',
        weight: 3,
        fillColor: '#1b9a94',
        fillOpacity: 1,
      }).addTo(map);

      marker.bindPopup(`<strong>${eventConfig.locationName}</strong>`);
      // Popup terbuka sejak awal supaya lokasi langsung jelas.
      marker.openPopup();
    };

    if ('IntersectionObserver' in window) {
      const seen = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            seen.disconnect();
            init();
          }
        },
        { rootMargin: '200px' },
      );
      seen.observe(container);
    } else {
      init();
    }
  }
</script>

<script>
  // Tombol menempel di bagian bawah layar HP setelah hero lewat,
  // dan hilang saat form terlihat.
  const cta = document.querySelector('.sticky-cta');
  const hero = document.getElementById('hero');
  const form = document.getElementById('form');
  if (cta && hero && form) {
    const io = new IntersectionObserver(
      (entries) => {
        const heroIn = entries.find((e) => e.target === hero)?.isIntersecting;
        const formIn = entries.find((e) => e.target === form)?.isIntersecting;
        if (formIn || heroIn) {
          cta.classList.add('is-hidden');
        } else {
          cta.classList.remove('is-hidden');
        }
      },
      { threshold: 0 },
    );
    io.observe(hero);
    io.observe(form);
  }
</script>

<style>
  .section {
    padding-block: var(--space-12);
  }

  /* Kepala bagian. */
  .section-head {
    max-width: 640px;
    margin: 0 auto var(--space-8);
    text-align: center;
  }

  .section-head h2 {
    margin-top: var(--space-2);
  }

  .section-head__tagline {
    margin-top: var(--space-3);
    color: var(--ink-soft);
  }

  /* Bagian bergaris atas-bawah dan latar kartu: memberi ritme antar-bagian. */
  .section--card {
    border-block: 1px solid var(--paper-grid);
    background: var(--paper-card);
  }

  /* --- Adegan cerita --- */
  :global(.story-list) {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  :global(.story-scene) {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--space-4) var(--space-6);
    align-items: start;
    padding-block: var(--space-6);
    border-top: 1px solid var(--paper-grid);
  }

  :global(.story-scene__num) {
    font-family: var(--font-heading);
    font-size: 2.8rem;
    font-weight: 700;
    line-height: 1;
    color: var(--teal);
    will-change: transform;
  }

  /* Nomor adegan genap memakai emas: selang-seling ala plakat. */
  :global(.story-scene--flip .story-scene__num) {
    color: var(--gold);
  }

  :global(.story-scene__heading) {
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    margin: 0 0 var(--space-2);
  }

  :global(.story-scene__text) {
    max-width: 52ch;
    color: var(--ink-soft);
    font-size: 1rem;
    will-change: transform;
  }

  @media (min-width: 720px) {
    :global(.story-list) {
      gap: 0;
    }

    :global(.story-scene) {
      grid-template-columns: 5rem 1fr;
      gap: var(--space-6);
      padding-block: var(--space-8);
    }

    /* Adegan genap: nomor pindah ke kanan lewat arah RTL. */
    :global(.story-scene--flip) {
      grid-template-columns: 1fr 5rem;
      direction: rtl;
    }

    :global(.story-scene--flip > *) {
      direction: ltr;
    }
  }

  /* --- Kartu insentif --- */
  .price-grid {
    display: grid;
    gap: var(--space-4);
    max-width: 920px;
    margin-inline: auto;
  }

  @media (min-width: 760px) {
    .price-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .price-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px solid var(--paper-grid);
    border-radius: 16px;
    background: #ffffff;
  }

  .price-card__label {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .price-card__amount {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
  }

  .price-card__amount span {
    margin-left: 0.2em;
    font-size: 0.45em;
  }

  .price-card__amount--muted {
    color: var(--ink-soft);
    text-decoration: line-through;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--maroon);
  }

  .price-card__note {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  /* Kartu utama: bidang teal penuh, teks putih — satu-satunya blok tebal. */
  .price-card--teal {
    border-color: var(--teal-dark);
    background: var(--teal-dark);
  }

  .price-card--teal .price-card__label,
  .price-card--teal .price-card__amount,
  .price-card--teal .price-card__note {
    color: #ffffff;
  }

  .price-card--teal .price-card__note {
    opacity: 0.85;
  }

  .price-card--gold {
    border-color: var(--gold);
    background: #f3e5c8;
  }

  .note {
    max-width: 640px;
    margin: var(--space-4) auto 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
    text-align: center;
  }

  /* --- Info acara + peta --- */
  .info-grid {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 880px) {
    .info-grid {
      grid-template-columns: 5fr 7fr;
    }
  }

  .info-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .info-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .info-list li {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--paper-grid);
  }
  .info-list strong {
    display: block;
    margin-bottom: 2px;
    color: var(--teal-dark);
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .info-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .map-card {
    overflow: hidden;
    border: 1px solid var(--paper-grid);
    border-radius: 16px;
    background: #ffffff;
  }

  .map-card__canvas {
    width: 100%;
    height: 360px;
    /* Nuansa tenang: sedikit didesaturasi supaya menyatu dengan tema kertas. */
    filter: grayscale(0.25) saturate(0.85);
  }

  .map-card__fallback {
    padding: var(--space-4);
    color: var(--ink-soft);
  }

  /* Kontrol Leaflet diselaraskan dengan tema (tetap datar). */
  .map-card :global(.leaflet-control-attribution) {
    font-size: 0.62rem;
    background: rgba(250, 246, 236, 0.85);
    color: var(--ink-soft);
  }

  .map-card :global(.leaflet-popup-content-wrapper) {
    border-radius: 10px;
    color: var(--ink);
    font-family: var(--font-body);
  }

  /* --- Rundown --- */
  .rundown-list {
    display: flex;
    flex-direction: column;
    max-width: 820px;
    margin-inline: auto;
    padding: 0;
    list-style: none;
  }

  .rundown-item {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: var(--space-6);
    padding-block: var(--space-4);
    border-top: 1px solid var(--paper-grid);
  }

  .rundown-item:first-child {
    border-top: 0;
  }

  .rundown-time {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--teal-dark);
    font-size: 0.92rem;
    white-space: nowrap;
  }

  .rundown-item-title {
    margin: 0 0 var(--space-1);
    font-size: 1rem;
  }

  .rundown-item-desc {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .rundown-item {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }

  /* --- Form --- */
  .form-wrap {
    max-width: 640px;
  }

  /* --- Footer --- */
  .site-footer {
    margin-top: var(--space-12);
    padding-block: var(--space-12);
    background: var(--ink);
    color: var(--paper);
  }
  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }
  .site-footer p {
    margin-bottom: var(--space-2);
    color: #dce5df;
  }
  .site-footer__eyebrow {
    color: var(--gold) !important;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .site-footer__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .site-footer__legal {
    color: #dce5df;
    font-size: 0.875rem;
  }
  @media (max-width: 640px) {
    .site-footer__inner { align-items: flex-start; flex-direction: column; }
  }

  /* --- CTA menempel (mobile) --- */
  .sticky-cta {
    position: fixed;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 20;
    display: none;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
    border: var(--line) solid var(--teal-dark);
    border-radius: 999px;
    background: var(--teal-dark);
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
    min-height: 48px;
    transition: transform 0.06s ease;
  }
  .sticky-cta:active {
    transform: translateY(2px);
  }
  .sticky-cta.is-hidden {
    display: none;
  }

  @media (max-width: 719px) {
    .sticky-cta {
      display: flex;
    }
  }
</style>

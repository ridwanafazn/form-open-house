---
import Base from '../layouts/Base.astro';
import { content } from '../config/content';
import { eventConfig } from '../config/event';

const p = content.privacy;
const deleteWa = `https://wa.me/${eventConfig.admissionWhatsApp}?text=${encodeURIComponent(
  'Halo tim Admisi, saya ingin meminta penghapusan data pendaftaran Open House saya.'
)}`;

const rows: Array<[string, string]> = [
  ['Pengelola data', p.collector],
  ['Data yang dikumpulkan', p.dataCollected],
  ['Tujuan penggunaan', p.purpose],
  ['Akses data', p.viewers],
  ['Lama penyimpanan', p.storageDuration],
  ['Distribusi pihak ketiga', p.noSharing],
];
---

<Base title="Kebijakan Privasi | Open House SMKIT As-Syifa">
  <main class="privacy container">
    <header class="privacy__head">
      <p class="privacy__kicker">Transparansi</p>
      <h1>Kebijakan Privasi</h1>
      <p class="privacy__lede">
        Kami menghargai privasi Anda. Ringkasan ini menjelaskan bagaimana kami
        mengelola data pendaftaran Open House secara aman dan terbatas pada
        keperluannya.
      </p>
    </header>

    <dl class="privacy-table">
      {rows.map(([term, value]) => (
        <div class="privacy-row">
          <dt>{term}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>

    <div class="privacy-delete">
      <div>
        <h2>Hak penghapusan data</h2>
        <p>
          Anda berhak meminta kami menghapus seluruh data pendaftaran Anda dari
          sistem kami secara permanen.
        </p>
      </div>
      <a href={deleteWa} rel="noopener noreferrer" target="_blank" class="button button--secondary">
        Hubungi Admisi
      </a>
    </div>

    <p class="privacy__back"><a href="/">Kembali ke halaman utama</a></p>
  </main>
</Base>

<style>
  .privacy {
    max-width: 760px;
    padding-block: var(--space-12) var(--space-16);
  }

  .privacy__head {
    margin-bottom: var(--space-8);
  }

  .privacy__kicker {
    color: var(--teal-dark);
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .privacy__head h1 {
    margin-top: var(--space-2);
  }

  .privacy__lede {
    max-width: 52ch;
    margin-top: var(--space-4);
    color: var(--ink-soft);
    font-size: 1.05rem;
  }

  .privacy-table {
    margin: 0;
    border: 1px solid var(--paper-grid);
    border-radius: 16px;
    background: #ffffff;
    overflow: hidden;
  }

  .privacy-row {
    display: grid;
    gap: var(--space-1) var(--space-6);
    padding: var(--space-4) var(--space-6);
    border-top: 1px solid var(--paper-grid);
  }

  .privacy-row:first-child {
    border-top: 0;
  }

  .privacy-row dt {
    color: var(--teal-dark);
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .privacy-row dd {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  @media (min-width: 640px) {
    .privacy-row {
      grid-template-columns: 220px 1fr;
      align-items: baseline;
    }
  }

  .privacy-delete {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--paper-grid);
    border-left: 4px solid var(--maroon);
    border-radius: 16px;
    background: var(--paper-card);
  }

  @media (min-width: 640px) {
    .privacy-delete {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .privacy-delete h2 {
    font-size: 1.05rem;
    margin-bottom: var(--space-1);
  }

  .privacy-delete p {
    color: var(--ink-soft);
    font-size: 0.92rem;
    max-width: 48ch;
  }

  .privacy__back {
    margin-top: var(--space-8);
    font-size: 0.9rem;
  }
</style>

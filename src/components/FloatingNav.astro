---
import { eventConfig } from '../config/event';

const admissionHref = `https://wa.me/${eventConfig.admissionWhatsApp}?text=${encodeURIComponent(
  'Assalamualaikum. Saya ingin bertanya tentang Open House SMKIT As Syifa.',
)}`;

interface Props {
  adminMode?: boolean;
}

const { adminMode = false } = Astro.props;
---

<nav class:list={['floating-nav', { 'floating-nav--admin': adminMode }]} aria-label={adminMode ? 'Navigasi admin' : 'Navigasi utama'}>
  <a class="floating-nav__brand" href={adminMode ? '/admin' : '/'} aria-label={adminMode ? 'Halaman admin' : 'Beranda Open House SMKIT As Syifa'}>
    <img class="floating-nav__logo" src="/images/logo.png" alt="Logo SMKIT As Syifa" width="34" height="34" />
    <span class="floating-nav__brand-text">{adminMode ? 'Admin Open House' : 'Open House'}</span>
  </a>
  <button class="floating-nav__toggle" type="button" aria-expanded="false" aria-controls="floating-nav-links">
    <span class="floating-nav__toggle-lines" aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="floating-nav__toggle-label">Menu</span>
  </button>
  <div class="floating-nav__links" id="floating-nav-links">
    {adminMode ? (
      <>
        <a href="#dashboard">Dashboard</a>
        <a href="#scan">Scan presensi</a>
        <a href="/">Lihat situs</a>
      </>
    ) : (
      <>
        <a href="/">Home</a>
        <a href="/#story">Pengalaman</a>
        <a href="/#event-info">Info acara</a>
        <a href="/#rundown">Rundown</a>
        <a href="/privasi">Kebijakan privasi</a>
        <a class="floating-nav__admission" href={admissionHref} rel="noopener" target="_blank">Admisi</a>
      </>
    )}
  </div>
</nav>

<script>
  const nav = document.querySelector('.floating-nav');
  const toggle = nav?.querySelector('.floating-nav__toggle');
  const links = nav?.querySelector('.floating-nav__links');

  if (nav && toggle && links) {
    const closeMenu = () => {
      nav.classList.remove('floating-nav--open');
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('floating-nav--open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    links.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 760) closeMenu();
    });
  }
</script>

<style>
  .floating-nav {
    position: fixed;
    z-index: 30;
    top: 16px;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    width: min(calc(100% - 32px), 1080px);
    min-height: 56px;
    padding: 8px 10px 8px 14px;
    transform: translateX(-50%);
    border: 1px solid var(--paper-grid);
    border-radius: 14px;
    background: var(--paper);
    color: var(--ink);
  }

  .floating-nav__brand,
  .floating-nav__links a {
    text-decoration: none;
  }

  .floating-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    flex: 0 0 auto;
    color: var(--ink);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .floating-nav__logo {
    width: 34px;
    height: 34px;
    object-fit: contain;
    border-radius: 8px;
  }

  .floating-nav__brand-text {
    white-space: nowrap;
    font-size: 0.9rem;
  }

  .floating-nav__toggle {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border: 1px solid var(--paper-grid);
    border-radius: 8px;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-heading);
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
  }

  .floating-nav__toggle-lines {
    display: grid;
    gap: 3px;
  }

  .floating-nav__toggle-lines span {
    display: block;
    width: 16px;
    height: 2px;
    background: currentColor;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .floating-nav__links {
    display: flex;
    align-items: center;
    gap: 3px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .floating-nav__links::-webkit-scrollbar {
    display: none;
  }

  .floating-nav__links a {
    flex: 0 0 auto;
    padding: 9px 10px;
    border-radius: 8px;
    color: var(--ink-soft);
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 600;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .floating-nav__links a:hover,
  .floating-nav__links a:focus-visible {
    background: var(--teal-pale);
    color: var(--teal-dark);
  }

  .floating-nav--admin {
    border-color: #b9c9d8;
    background: #edf3f7;
  }

  .floating-nav--admin .floating-nav__logo {
    border-radius: 50%;
  }

  .floating-nav__links .floating-nav__admission {
    border: 1px solid var(--teal-dark);
    background: var(--teal-dark);
    color: var(--paper);
  }

  .floating-nav__links .floating-nav__admission:hover,
  .floating-nav__links .floating-nav__admission:focus-visible {
    background: var(--teal);
    color: var(--paper);
  }

  .floating-nav--admin .floating-nav__links a:hover,
  .floating-nav--admin .floating-nav__links a:focus-visible {
    background: #d9e6f0;
    color: #294b67;
  }

  @media (max-width: 760px) {
    .floating-nav {
      top: 10px;
      width: calc(100% - 20px);
      gap: 8px;
      padding: 8px 10px;
    }

    .floating-nav__brand-text {
      display: none;
    }

    .floating-nav__toggle {
      display: inline-flex;
      margin-left: auto;
    }

    .floating-nav__links {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      left: 0;
      display: grid;
      gap: 4px;
      max-height: 0;
      padding: 0 8px;
      overflow: hidden;
      border: 1px solid transparent;
      border-radius: 12px;
      background: var(--paper);
      opacity: 0;
      transform: translateY(-8px);
      transition: max-height 220ms ease, opacity 180ms ease, transform 220ms ease, padding 220ms ease, border-color 220ms ease;
      pointer-events: none;
    }

    .floating-nav--open .floating-nav__links {
      max-height: 360px;
      padding-block: 8px;
      border-color: var(--paper-grid);
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .floating-nav__links a {
      padding: 10px;
      font-size: 0.8rem;
    }

    .floating-nav--open .floating-nav__toggle-lines span:nth-child(1) {
      transform: translateY(5px) rotate(45deg);
    }

    .floating-nav--open .floating-nav__toggle-lines span:nth-child(2) {
      opacity: 0;
    }

    .floating-nav--open .floating-nav__toggle-lines span:nth-child(3) {
      transform: translateY(-5px) rotate(-45deg);
    }
  }
</style>

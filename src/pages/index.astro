---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import RegisterForm from '../components/RegisterForm';
import { content } from '../config/content';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<Base>
  <main>
    <Hero />

    <section class="section" id="form" aria-labelledby="form-title">
      <div class="container form-wrap">
        <h2 id="form-title">{content.home.form.heading}</h2>
        <p class="form-tagline">{content.home.form.tagline}</p>
        <RegisterForm client:visible turnstileSiteKey={turnstileSiteKey} />
      </div>
    </section>
  </main>

  <a class="sticky-cta" href="#form">{content.home.hero.cta}</a>
</Base>

<script>
  // Tombol menempel di bagian bawah layar HP setelah hero lewat,
  // dan hilang saat form terlihat.
  const cta = document.querySelector('.sticky-cta');
  const hero = document.getElementById('hero');
  const form = document.getElementById('form');
  if (cta && hero && form) {
    const io = new IntersectionObserver(
      (entries) => {
        const heroIn = entries.find((e) => e.target === hero)?.isIntersecting;
        const formIn = entries.find((e) => e.target === form)?.isIntersecting;
        if (formIn || heroIn) {
          cta.classList.add('is-hidden');
        } else {
          cta.classList.remove('is-hidden');
        }
      },
      { threshold: 0 },
    );
    io.observe(hero);
    io.observe(form);
  }
</script>

<style>
  .section {
    padding-block: var(--space-12);
  }
  .placeholder-note {
    color: var(--ink-soft);
    margin-top: var(--space-4);
  }

  .form-tagline {
    color: var(--ink-soft);
    margin-block: 0 var(--space-6);
  }

  .form-wrap {
    max-width: 640px;
  }

  .sticky-cta {
    position: fixed;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 20;
    display: none;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    background: var(--teal);
    color: var(--paper);
    text-decoration: none;
    font-weight: 600;
    min-height: 48px;
    transition: transform 0.06s ease;
  }
  .sticky-cta:active {
    transform: translateY(2px);
  }
  .sticky-cta.is-hidden {
    visibility: hidden;
  }

  @media (max-width: 719px) {
    .sticky-cta {
      display: flex;
    }
  }
</style>

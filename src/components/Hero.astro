---
import { content } from '../config/content';
import { eventConfig } from '../config/event';
import CornerBrackets from './ui/CornerBrackets.astro';

const monthLabels = [
  'JAN',
  'FEB',
  'MAR',
  'APR',
  'MEI',
  'JUN',
  'JUL',
  'AGU',
  'SEP',
  'OKT',
  'NOV',
  'DES',
];
const [year, month, day] = eventConfig.dateISO.split('-');
const dateLabel = `${day} ${monthLabels[Number(month) - 1]} ${year}`;

const pillars = [
  {
    lines: ['LAB MULTIMEDIA', 'PRODUKSI VIDEO'],
    tone: 'teal',
    image: '/images/hero/lab-multimedia.jpg',
  },
  {
    lines: ['STUDIO TEATER', 'RUANG KEGIATAN'],
    tone: 'ink',
    image: '/images/hero/studio-teater.jpg',
  },
  {
    lines: ['PEMAPARAN', 'JURUSAN RPL DKV'],
    tone: 'ink',
    image: '/images/hero/presentasi.jpg',
  },
  {
    lines: ['LOBI DAN', 'KONSULTASI'],
    tone: 'teal',
    image: '/images/hero/lobi.jpg',
  },
];
---

<section
  id="hero"
  data-hero
  class="hero relative isolate flex h-[100svh] min-h-[650px] flex-col justify-end overflow-hidden bg-ink text-paper"
>
  <!-- Foto masjid sebagai latar utama. Lapisan gelap datar menjaga teks tetap
       terbaca tanpa gradien, blur, atau bayangan. -->
  <img
    class="hero__photo"
    src="/images/hero/masjid.jpg"
    srcset="/images/hero/masjid-960.jpg 960w, /images/hero/masjid.jpg 1920w"
    sizes="100vw"
    alt=""
    width="1920"
    height="1080"
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero__overlay" aria-hidden="true"></div>

  <!-- Header statis: hanya logo dan teks kecil. Tidak ada tautan navigasi. -->
  <header class="absolute inset-x-0 top-0 z-40 flex items-start justify-between p-6 md:px-12 md:py-8">
    <a class="hero__brand flex items-start gap-3" href="/" aria-label="Beranda Open House SMKIT As Syifa">
      <img
        class="h-9 w-9 rounded-full bg-paper object-contain p-1 md:h-10 md:w-10"
        src="/images/logo.png"
        alt="Logo SMKIT As Syifa"
        width="40"
        height="40"
      />
      <span
        class="pt-1 font-tech text-[9px] font-bold uppercase leading-tight tracking-[0.2em] text-paper/80 md:text-[10px]"
      >
        <span class="block">SMKIT AS SYIFA</span>
        <span class="block">BOARDING SCHOOL</span>
      </span>
    </a>

    <span class="-skew-x-12 pt-1 font-syifa-display text-xl font-bold tracking-[0.12em] text-paper/90 md:text-2xl">
      2K26
    </span>
  </header>

  <div class="hero__content">
    <p
      class="hero__eyebrow hidden max-w-[280px] text-center font-tech text-[11px] font-bold uppercase leading-relaxed tracking-[0.18em] text-paper/80 md:block md:max-w-none md:text-sm"
    >
      PAMERAN VOKASI DAN BOARDING ECOSYSTEM
    </p>

    <div
      class="hero__meta mb-2 flex w-full max-w-[320px] justify-between px-2 font-tech text-[9px] font-bold uppercase tracking-[0.18em] md:max-w-5xl md:px-8 md:text-xs"
    >
      <span class="text-paper/90">{dateLabel}</span>
      <span class="text-syifa-gold">AS SYIFA</span>
      <span class="text-right text-paper/90">SUBANG JAWA BARAT</span>
    </div>

    <h1 class="hero__title font-syifa-display uppercase">
      <span>OPEN</span>
      <span>HOUSE</span>
    </h1>

    <!-- Tombol utama tepat di atas pilar, menggantikan pilar "Ambil Tiket". -->
    <a class="hero__cta" href="#form">{content.home.hero.heroCta}</a>
  </div>

  <h2 class="sr-only">Fasilitas open house</h2>

  <!-- Empat pilar: grid 2x2 di HP, empat kolom sejajar di desktop.
       Semua pilar memakai foto asli sekolah. Tombol CTA tidak lagi menjadi
       salah satu pilar, sehingga tidak ada label yang tertutup. -->
  <div
    class="hero__pillars relative z-20 grid w-full grid-cols-2 border-t border-paper-grid bg-paper-card md:grid-cols-4"
  >
    {
      pillars.map((pillar) => (
        <article
          class:list={[
            'pillar group relative flex flex-col items-center justify-center overflow-hidden p-3 text-center md:p-6',
            `pillar--${pillar.tone}`,
          ]}
        >
          <img
            class="pillar__image"
            src={pillar.image}
            alt=""
            width="1200"
            height="675"
            loading="lazy"
            decoding="async"
          />
          <span class="pillar__scrim" aria-hidden="true" />
          <CornerBrackets />
          <h3 class:list={['pillar__label', `pillar__label--${pillar.tone}`]}>
            <span class="block">{pillar.lines[0]}</span>
            <span class="block">{pillar.lines[1]}</span>
          </h3>
        </article>
      ))
    }
  </div>
</section>

<style>
  .hero__brand {
    text-decoration: none;
  }

  .hero__brand:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }

  .hero__photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
  }

  /* Lapisan gelap datar: tidak ada gradien, hanya satu warna dengan opasitas. */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(15, 19, 23, 0.66);
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 10;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: 96px var(--space-4) var(--space-4);
  }

  .hero__eyebrow {
    margin: 0 0 32px;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 12px 0 0;
    color: #ffffff;
    font-size: min(26vw, 16vh);
    font-weight: 700;
    line-height: 0.78;
    letter-spacing: -0.045em;
    transform: skewX(-12deg);
    transform-origin: center;
  }

  .hero__title span {
    display: block;
    white-space: nowrap;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: var(--space-6);
    padding: 12px 28px;
    border: 1px solid var(--paper);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .hero__cta:hover {
    background: #ffffff;
    border-color: #ffffff;
  }

  .hero__cta:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }

  .hero__pillars {
    height: 40vh;
    min-height: 280px;
  }

  .pillar {
    --bracket-color: rgba(34, 38, 42, 0.3);
    border-right: 1px solid var(--paper-grid);
    border-bottom: 1px solid var(--paper-grid);
    background-color: var(--paper-card);
    isolation: isolate;
  }

  .pillar:nth-child(2n) {
    border-right: 0;
  }

  .pillar:nth-child(n + 3) {
    border-bottom: 0;
  }

  .pillar__image {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.32;
    filter: grayscale(100%);
    transition:
      opacity 0.5s ease,
      filter 0.5s ease,
      transform 0.8s ease;
  }

  .pillar__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(250, 246, 236, 0.52);
  }

  .pillar__label {
    position: relative;
    z-index: 2;
    margin: 0;
    font-family: var(--font-tech);
    font-size: 9px;
    font-weight: 700;
    line-height: 1.9;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition:
      color 0.3s ease,
      text-shadow 0.3s ease;
  }

  .pillar__label--teal {
    color: var(--teal-dark);
  }

  .pillar__label--ink {
    color: var(--ink);
  }

  @media (min-width: 768px) {
    .hero__title {
      flex-direction: row;
      gap: 0.1em;
      margin-top: 20px;
      font-size: min(18vw, 28vh);
      line-height: 0.8;
    }

    .hero__pillars {
      height: clamp(220px, 25vh, 300px);
      min-height: 0;
    }

    .pillar {
      border-right: 1px solid var(--paper-grid);
      border-bottom: 0;
    }

    .pillar:nth-child(2n) {
      border-right: 1px solid var(--paper-grid);
    }

    .pillar:last-child {
      border-right: 0;
    }

    .pillar__label {
      font-size: 11px;
    }
  }

  @media (min-width: 1024px) {
    .pillar__label {
      font-size: 13px;
    }
  }

  @media (max-width: 767px) {
    /* Judul sedikit ditebalkan dengan garis luar sewarna teks. */
    .hero__title {
      -webkit-text-stroke: 1.5px #ffffff;
      paint-order: stroke fill;
    }
  }

  @media (hover: hover) {
    .pillar:hover .pillar__image {
      opacity: 0.5;
      filter: grayscale(0%);
      transform: scale(1.04);
    }

    .pillar:hover .pillar__label {
      color: var(--ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pillar__image,
    .pillar__label,
    .hero__cta {
      transition: none;
    }
  }
</style>

---
import Base from '../../layouts/Base.astro';
import PublicTicket from '../../components/PublicTicket';
export const prerender = false;

const code = Astro.params.code ?? '';
---

<Base title={`Tiket ${code}`} description="Tiket digital Open House SMKIT As Syifa Boarding School.">
  <meta slot="head" name="robots" content="noindex" />
  <main class="ticket-page container">
    <p class="ticket-page__back"><a href="/">Kembali ke halaman utama</a></p>
    <PublicTicket client:load code={code} />
    <p class="ticket-page__footnote">Tiket ini ditujukan untuk keperluan registrasi Open House. Simpan tautan ini sampai hari acara.</p>
  </main>
</Base>

<style>
  /* Latar dan tipografi mengikuti token admin.css, sudah diimpor via PublicTicket. */
  .ticket-page { padding-block: 20px 64px; }
  .ticket-page__back { max-width: 620px; margin: 0 auto; font-size: .9rem; font-family: 'DM Sans', sans-serif; }
  .ticket-page__back a { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border: 1px solid var(--admin-border, #E2E8F0); border-radius: var(--radius-md, 10px); background: var(--admin-surface, #FFFFFF); color: var(--admin-text-main, #1E293B); text-decoration: none; transition: all .2s; }
  .ticket-page__back a:hover { background: #F1F5F9; color: var(--admin-primary, #0F172A); }
  .ticket-page__footnote { max-width: 620px; margin: 18px auto; color: var(--admin-text-muted, #64748B); font-family: 'DM Sans', sans-serif; font-size: .85rem; text-align: center; }
</style>

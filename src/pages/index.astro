---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StorySection from '../components/StorySection';
import AddCalendar from '../components/AddCalendar';
import RegisterForm from '../components/RegisterForm';
import { content } from '../config/content';
import { eventConfig } from '../config/event';

// Kunci uji resmi Cloudflare Turnstile yang selalu lolos otomatis (mode pass)
const CLOUDFLARE_TEST_SITE_KEY = '1x00000000000000000000AA';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || CLOUDFLARE_TEST_SITE_KEY;
---

<Base>
  <main>
    <Hero />

    <section class="section" id="story" aria-labelledby="story-title">
      <div class="container">
        <h2 id="story-title">Apa yang bisa dilihat dan dicoba</h2>
        <!-- Konten statis: tampil langsung tanpa JS -->
        <div class="story-list story-list--static" id="story-static">
          {content.home.story.map((scene, i) => (
            <div class={`story-scene${i % 2 !== 0 ? ' story-scene--flip' : ''}`}>
              <div class="story-scene__num">{String(i + 1).padStart(2, '0')}</div>
              <div class="story-scene__body">
                <h3 class="story-scene__heading">{scene.heading}</h3>
                <p class="story-scene__text">{scene.text}</p>
              </div>
            </div>
          ))}
        </div>
        <!-- Island animasi: menggantikan konten statis saat JS aktif -->
        <StorySection client:visible />
      </div>
    </section>

    <section class="section" id="incentiv" aria-labelledby="incentiv-title">
      <div class="container">
        <h2 id="incentiv-title">{content.home.incentive.heading}</h2>
        <p>{content.home.incentive.text}</p>
        <p class="note">{content.home.incentive.note}</p>
      </div>
    </section>

    <section class="section" id="event-info" aria-labelledby="event-info-title">
      <div class="container">
        <h2 id="event-info-title">{eventConfig.name}</h2>
        <ul class="info-list">
          <li><strong>Hari dan tanggal</strong> {eventConfig.dateText}</li>
          <li><strong>Jam</strong> {eventConfig.startTime} sampai {eventConfig.endTime} WIB</li>
          <li><strong>Tempat</strong> {eventConfig.locationName}</li>
          <li><strong>Alamat</strong> {eventConfig.locationAddress}</li>
        </ul>
        <div class="info-actions">
          <a class="button button--primary" href={eventConfig.mapsUrl} rel="noopener" target="_blank">{content.home.eventInfo.openMap}</a>
          <AddCalendar client:visible />
        </div>
        <div class="map-preview">
          <iframe
            src={eventConfig.mapsEmbedUrl}
            width="100%"
            height="320"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Peta Lokasi SMKIT As Syifa Subang"
          ></iframe>
        </div>
      </div>
    </section>

    <section class="section" id="rundown" aria-labelledby="rundown-title">
      <div class="container">
        <h2 id="rundown-title">{content.home.rundown.heading}</h2>
        <p class="rundown-tagline">{content.home.rundown.tagline}</p>
        <div class="rundown-list">
          {content.home.rundown.items.map((item) => (
            <div class="rundown-item">
              <div class="rundown-time">{item.time}</div>
              <div class="rundown-content">
                <h3 class="rundown-item-title">{item.title}</h3>
                <p class="rundown-item-desc">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="form" aria-labelledby="form-title">
      <div class="container form-wrap">
        <h2 id="form-title">{content.home.form.heading}</h2>
        <p class="form-tagline">{content.home.form.tagline}</p>
        <RegisterForm client:visible turnstileSiteKey={turnstileSiteKey} />
      </div>
    </section>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div>
          <p class="site-footer__eyebrow">SMKIT As Syifa Boarding School</p>
          <p>{content.home.footer.text}</p>
        </div>
        <div class="site-footer__actions">
          <a
            class="button button--primary"
            href={`https://wa.me/${eventConfig.admissionWhatsApp}?text=${encodeURIComponent('Assalamualaikum. Saya ingin bertanya tentang Open House SMKIT As Syifa.')}`}
            rel="noopener"
            target="_blank"
          >{content.home.footer.cta}</a>
          <a class="site-footer__legal" href="/privasi">Kebijakan privasi</a>
        </div>
      </div>
    </footer>
  </main>

  <a class="sticky-cta" href="#form">{content.home.hero.cta}</a>
</Base>

<script>
  // Tombol menempel di bagian bawah layar HP setelah hero lewat,
  // dan hilang saat form terlihat.
  const cta = document.querySelector('.sticky-cta');
  const hero = document.getElementById('hero');
  const form = document.getElementById('form');
  if (cta && hero && form) {
    const io = new IntersectionObserver(
      (entries) => {
        const heroIn = entries.find((e) => e.target === hero)?.isIntersecting;
        const formIn = entries.find((e) => e.target === form)?.isIntersecting;
        if (formIn || heroIn) {
          cta.classList.add('is-hidden');
        } else {
          cta.classList.remove('is-hidden');
        }
      },
      { threshold: 0 },
    );
    io.observe(hero);
    io.observe(form);
  }
</script>

<style>
  .section {
    padding-block: var(--space-12);
  }

  /* Bagian cerita */
  #story h2 {
    margin-bottom: var(--space-8);
  }

  :global(.story-list) {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  :global(.story-scene) {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-4) var(--space-6);
    align-items: start;
    padding-block: var(--space-6);
    border-top: 2px solid var(--paper-grid);
  }

  :global(.story-scene__num) {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--teal);
    will-change: transform;
  }

  :global(.story-scene__heading) {
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    margin: 0 0 var(--space-2);
  }

  :global(.story-scene__text) {
    color: var(--ink-soft);
    font-size: 1rem;
    will-change: transform;
  }

  @media (min-width: 720px) {
    :global(.story-list) {
      gap: 0;
    }

    :global(.story-scene) {
      grid-template-columns: 4rem 1fr 2fr;
      gap: var(--space-6);
      padding-block: var(--space-8);
    }

    :global(.story-scene--flip) {
      grid-template-columns: 2fr 1fr 4rem;
      direction: rtl;
    }

    :global(.story-scene--flip > *) {
      direction: ltr;
    }
  }
  .placeholder-note {
    color: var(--ink-soft);
    margin-top: var(--space-4);
  }

  .form-tagline {
    color: var(--ink-soft);
    margin-block: 0 var(--space-6);
  }

  .form-wrap {
    max-width: 640px;
  }

  .note {
    color: var(--ink-soft);
    margin-top: var(--space-4);
  }

  .info-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
  }
  .info-list li {
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--paper-grid);
  }
  .info-list strong {
    display: inline-block;
    min-width: 140px;
    color: var(--teal-dark);
  }
  .info-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block: var(--space-4);
  }

  .map-preview {
    margin-top: var(--space-6);
    border: 1px solid var(--paper-grid);
    border-radius: 4px;
    overflow: hidden;
    background: var(--paper-card);
  }

  .map-preview iframe {
    display: block;
  }

  .rundown-tagline {
    color: var(--ink-soft);
    margin-block: 0 var(--space-6);
  }

  .rundown-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .rundown-item {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--paper-card);
    border: 1px solid var(--paper-grid);
    border-radius: 4px;
  }

  .rundown-time {
    font-weight: 700;
    color: var(--teal-dark);
    font-size: var(--text-sm);
  }

  .rundown-item-title {
    margin: 0 0 var(--space-1);
    font-size: var(--text-base);
  }

  .rundown-item-desc {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .rundown-item {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }

  .site-footer {
    margin-top: var(--space-12);
    padding-block: var(--space-12);
    background: var(--ink);
    color: var(--paper);
  }
  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }
  .site-footer p {
    margin-bottom: var(--space-2);
    color: #dce5df;
  }
  .site-footer__eyebrow {
    color: var(--teal-pale) !important;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .site-footer__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .site-footer__legal {
    color: var(--teal-pale);
    font-size: 0.875rem;
  }
  @media (max-width: 640px) {
    .site-footer__inner { align-items: flex-start; flex-direction: column; }
  }

  .sticky-cta {
    position: fixed;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 20;
    display: none;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    background: var(--teal);
    color: var(--paper);
    text-decoration: none;
    font-weight: 600;
    min-height: 48px;
    transition: transform 0.06s ease;
  }
  .sticky-cta:active {
    transform: translateY(2px);
  }
  .sticky-cta.is-hidden {
    display: none;
  }

  @media (max-width: 719px) {
    .sticky-cta {
      display: flex;
    }
  }
</style>

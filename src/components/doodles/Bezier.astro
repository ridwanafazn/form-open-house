---
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className = '' } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" class={className}>
  <path d="M14 50 Q20 20 32 28 T50 16"
    fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" />
  <path d="M14 50 L20 30 M50 16 L43 24"
    fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" />
  <rect x="12" y="48" width="4" height="4" fill="var(--teal)" />
  <rect x="48" y="14" width="4" height="4" fill="var(--maroon)" />
</svg>

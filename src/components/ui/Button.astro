---
// Tombol doff: padat satu warna dengan garis tepi. Saat ditekan bergeser 2px ke bawah.
interface Props {
  href?: string;
  htmlType?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary';
  class?: string;
  'aria-label'?: string;
  disabled?: boolean;
}

const {
  href,
  htmlType = 'button',
  variant = 'primary',
  class: className = '',
  'aria-label': ariaLabel,
  disabled = false,
} = Astro.props;

const classes = ['button', `button--${variant}`, className].filter(Boolean).join(' ');
const hrefAttr = href ?? '#';
const typeAttr = htmlType;
const disabledAttr = disabled ? 'disabled' : undefined;
---

{
  href ? (
    <a href={hrefAttr} class={classes} aria-label={ariaLabel}>
      <slot />
    </a>
  ) : (
    <button type={typeAttr} class={classes} aria-label={ariaLabel} disabled={disabledAttr}>
      <slot />
    </button>
  )
}


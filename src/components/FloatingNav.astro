---
import { eventConfig } from '../config/event';

const admissionHref = `https://wa.me/${eventConfig.admissionWhatsApp}?text=${encodeURIComponent(
  'Assalamualaikum. Saya ingin bertanya tentang Open House SMKIT As Syifa.',
)}`;

interface Props {
  adminMode?: boolean;
  variant?: 'default' | 'landing';
}

const { adminMode = false, variant = 'default' } = Astro.props;
const isLanding = variant === 'landing';
---

<nav
  class:list={[
    'floating-nav',
    {
      'floating-nav--admin': adminMode,
      'floating-nav--gate': isLanding,
    },
  ]}
  data-landing-nav={isLanding ? '' : undefined}
  aria-label={adminMode ? 'Navigasi admin' : 'Navigasi utama'}
  aria-hidden={isLanding ? 'true' : undefined}
  inert={isLanding ? true : undefined}
>
  <div class="floating-nav__container">
    <a
      class="floating-nav__brand"
      href={adminMode ? '/admin' : '/'}
      aria-label={adminMode ? 'Halaman admin' : 'Beranda Open House SMKIT As Syifa'}
    >
      <img
        class="floating-nav__logo"
        src="/images/logo.png"
        alt="Logo SMKIT As Syifa"
        width="32"
        height="32"
      />
      <span class="floating-nav__brand-text">
        {adminMode ? 'Admin Portal' : 'Open House As Syifa'}
      </span>
    </a>

    <button
      class="floating-nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="floating-nav-links"
      aria-label="Toggle Menu"
    >
      <span class="floating-nav__toggle-lines" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <div class="floating-nav__links" id="floating-nav-links">
      {adminMode ? (
        <>
          <a href="#dashboard" class="floating-nav__link">Dashboard</a>
          <a href="#scan" class="floating-nav__link">Scan Presensi</a>
          <a href="/" class="floating-nav__link">Lihat Situs</a>
          <button
            type="button"
            class="floating-nav__settings"
            id="admin-nav-settings"
            aria-haspopup="dialog"
            aria-label="Pengaturan pendaftaran"
            title="Pengaturan pendaftaran"
            hidden
          >
            <svg
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="3" />
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" />
            </svg>
            <span class="floating-nav__settings-label">Pengaturan</span>
          </button>
          <div class="floating-nav__user-group" id="admin-nav-user" hidden>
            <div class="floating-nav__user">
              <img
                class="floating-nav__avatar"
                id="admin-nav-avatar"
                src=""
                alt="Avatar"
                width="26"
                height="26"
              />
              <span class="floating-nav__user-name" id="admin-nav-name"></span>
            </div>
          </div>
          <button type="button" class="floating-nav__logout" id="admin-nav-logout">
            Keluar
          </button>
        </>
      ) : isLanding ? (
        <>
          <a href="#story" class="floating-nav__link">Fasilitas</a>
          <a href="#rundown" class="floating-nav__link">Rundown</a>
          <a
            class="floating-nav__link"
            href={admissionHref}
            rel="noopener"
            target="_blank"
          >
            Admisi
          </a>
          <a href="#form" class="floating-nav__link floating-nav__admission">
            <span>Daftar</span>
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </>
      ) : (
        <>
          <a href="/#event-info" class="floating-nav__link">Info Acara</a>
          <a href="/#rundown" class="floating-nav__link">Rundown</a>
          <a
            class="floating-nav__link floating-nav__admission"
            href={admissionHref}
            rel="noopener"
            target="_blank"
          >
            <span>Admisi</span>
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </>
      )}
    </div>
  </div>
</nav>

<script>
  // Landing navbar: tersembunyi sampai pengunjung melewati 70% tinggi hero.
  const landingNav = document.querySelector<HTMLElement>('[data-landing-nav]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (landingNav) {
    let frame = 0;

    const syncLandingNav = () => {
      frame = 0;
      const triggerHeight = hero ? hero.getBoundingClientRect().height * 0.7 : 0;
      const visible = !hero || window.scrollY > triggerHeight;

      landingNav.classList.toggle('is-visible', visible);
      if (visible) {
        landingNav.removeAttribute('inert');
        landingNav.removeAttribute('aria-hidden');
      } else {
        landingNav.setAttribute('inert', '');
        landingNav.setAttribute('aria-hidden', 'true');
      }
    };

    const requestSync = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(syncLandingNav);
    };

    syncLandingNav();
    window.addEventListener('scroll', requestSync, { passive: true });
    window.addEventListener('resize', requestSync);
  }

  // Navigasi bawaan untuk halaman non-landing dan panel admin.
  const nav = document.querySelector('.floating-nav');
  const toggle = nav?.querySelector('.floating-nav__toggle');
  const links = nav?.querySelector('.floating-nav__links');

  if (nav && toggle && links) {
    const closeMenu = () => {
      nav.classList.remove('floating-nav--open');
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('floating-nav--open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    links.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // Menutup menu mobile setelah membuka dialog pengaturan.
    nav.querySelector('#admin-nav-settings')?.addEventListener('click', closeMenu);

    window.addEventListener('resize', () => {
      if (window.innerWidth > 768) closeMenu();
    });
  }

  document
    .getElementById('admin-nav-logout')
    ?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('admin-logout'));
    });

  // Dialog pengaturan dirender oleh island React; navbar hanya memicu event.
  document
    .getElementById('admin-nav-settings')
    ?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('admin-settings'));
    });
</script>

<style>
  /* --- Navigasi landing memakai cangkang yang sama, hanya digerbangi skrip. --- */
  /* --- Navigasi bawaan: halaman non-landing dan panel admin --- */
  .floating-nav {
    position: fixed;
    z-index: 50;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: min(calc(100% - 32px), 1024px);
    /* Surface solid ala admin: tanpa blur, gradient, atau bayangan. */
    background: var(--admin-surface, #ffffff);
    border: 1px solid var(--admin-border, #e2e8f0);
    border-radius: 16px;
    font-family: 'DM Sans', sans-serif;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Landing: navbar klasik yang sama, tersembunyi sampai 70% tinggi hero. */
  .floating-nav--gate {
    opacity: 0;
    visibility: hidden;
    translate: 0 calc(-100% - 32px);
    pointer-events: none;
    transition:
      translate 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s ease,
      visibility 0s linear 0.5s;
  }

  .floating-nav--gate.is-visible {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    pointer-events: auto;
    transition:
      translate 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s ease;
  }

  .floating-nav :focus-visible {
    outline-color: var(--admin-primary, #0f172a);
  }

  .floating-nav__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 18px 10px 14px;
    min-height: 68px;
    gap: 16px;
  }

  .floating-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--admin-primary, #0f172a);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 0.92rem;
    letter-spacing: -0.02em;
    transition: opacity 0.2s ease;
  }

  .floating-nav__brand:hover {
    opacity: 0.8;
  }

  .floating-nav__logo {
    width: 32px;
    height: 32px;
    object-fit: contain;
    border-radius: 8px;
  }

  .floating-nav__links {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .floating-nav__link {
    text-decoration: none;
    padding: 8px 14px;
    border-radius: 10px;
    color: var(--admin-text-muted, #64748b);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.84rem;
    font-weight: 600;
    white-space: nowrap;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .floating-nav__link:hover,
  .floating-nav__link:focus-visible {
    background: #f1f5f9;
    color: var(--admin-primary, #0f172a);
  }

  .floating-nav__admission {
    background: var(--admin-primary, #0f172a);
    color: #ffffff !important;
  }

  .floating-nav__admission:hover {
    background: #1e293b !important;
  }

  .floating-nav__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--admin-border, #e2e8f0);
    border-radius: 10px;
    background: transparent;
    color: var(--admin-primary, #0f172a);
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .floating-nav__toggle:hover {
    background: #f1f5f9;
  }

  .floating-nav__toggle-lines {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 16px;
  }

  .floating-nav__toggle-lines span {
    display: block;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s ease;
  }

  /* Admin mode memakai shell visual yang sama; hanya isi tautannya berbeda. */
  .floating-nav--admin {
    background: var(--admin-surface, #ffffff);
    border-color: var(--admin-border, #e2e8f0);
  }

  .floating-nav__user-group {
    display: inline-flex;
    align-items: center;
  }

  /* Elemen dengan atribut `hidden` harus benar-benar hilang, meski kelasnya
     memberi `display`. Tanpa ini `hidden` kalah oleh aturan display di atas. */
  [hidden].floating-nav__user-group,
  [hidden].floating-nav__settings {
    display: none !important;
  }

  /* Tombol pengaturan: ikon saja di desktop, menempel pada kluster akun. */
  .floating-nav__settings {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--admin-border, #e2e8f0);
    border-radius: 10px;
    background: transparent;
    color: var(--admin-text-muted, #64748b);
    font-family: 'DM Sans', sans-serif;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .floating-nav__settings:hover,
  .floating-nav__settings:focus-visible {
    background: #f1f5f9;
    border-color: #cbd5e1;
    color: var(--admin-primary, #0f172a);
  }

  .floating-nav__settings-label {
    display: none;
  }

  .floating-nav__user {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px 4px 4px;
    border: 1px solid var(--admin-border, #e2e8f0);
    border-radius: 99px;
    background: var(--admin-bg, #f8fafc);
  }

  .floating-nav__avatar {
    width: 26px;
    height: 26px;
    border-radius: 10px;
    object-fit: cover;
  }

  .floating-nav__user-name {
    max-width: 130px;
    overflow: hidden;
    color: var(--admin-primary, #0f172a);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .floating-nav__logout {
    padding: 7px 14px;
    border: 1px solid var(--admin-border, #e2e8f0);
    border-radius: 10px;
    background: transparent;
    color: #b91c1c;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .floating-nav__logout:hover {
    background: #fef2f2;
    border-color: #fecaca;
    color: #b91c1c;
  }

  /* Responsive / Mobile styles */
  @media (max-width: 768px) {
    .floating-nav {
      top: 12px;
      width: calc(100% - 24px);
      border-radius: 16px;
    }

    .floating-nav__container {
      padding: 10px 12px;
      min-height: 60px;
    }

    .floating-nav__toggle {
      display: inline-flex;
    }

    .floating-nav__links {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      padding: 0;
      max-height: 0;
      overflow: hidden;
      background: var(--admin-surface, #ffffff);
      border: 1px solid transparent;
      border-radius: 16px;
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .floating-nav--open .floating-nav__links {
      max-height: 400px;
      padding: 10px;
      border-color: var(--admin-border, #e2e8f0);
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .floating-nav__link {
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 0.9rem;
    }

    .floating-nav__user-group {
      width: 100%;
    }

    /* Di menu mobile, tombol pengaturan mengikuti tampilan tautan lain
       (Dashboard/Scan Presensi/Lihat Situs): tanpa kotak, warna redup,
       dan sorotan latar saat disentuh. */
    .floating-nav__settings {
      width: 100%;
      height: auto;
      justify-content: flex-start;
      gap: 6px;
      padding: 10px 14px;
      border: none;
      border-radius: 10px;
      background: transparent;
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--admin-text-muted, #64748b);
    }

    .floating-nav__settings:hover,
    .floating-nav__settings:focus-visible {
      border-color: transparent;
      background: #f1f5f9;
      color: var(--admin-primary, #0f172a);
    }

    .floating-nav__settings-label {
      display: inline;
    }

    /* Menu mobile berbasis teks; ikon disembunyikan agar teks rata kiri
       persis seperti tautan lain. Di desktop tombol tetap ikon saja. */
    .floating-nav__settings svg {
      display: none;
    }

    .floating-nav__user {
      width: 100%;
      padding: 6px 12px 6px 6px;
      border-radius: 10px;
    }

    .floating-nav__logout {
      width: 100%;
      text-align: center;
      padding: 10px;
      border-radius: 10px;
    }

    /* Hamburger animation */
    .floating-nav--open .floating-nav__toggle-lines span:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }

    .floating-nav--open .floating-nav__toggle-lines span:nth-child(2) {
      opacity: 0;
    }

    .floating-nav--open .floating-nav__toggle-lines span:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }
  }
</style>

# Variabel lingkungan untuk aplikasi Open House SMKIT As Syifa.
# Salin berkas ini menjadi .env dan isi nilainya. Jangan commit .env.

# Alamat situs. Lokal: http://localhost:4321. Produksi: alamat pages.dev.
PUBLIC_SITE_URL=

# Pasangan kunci Turnstile. Untuk lokal dan uji, pakai kunci uji Cloudflare yang selalu lolos.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Koneksi Supabase. Hanya untuk server (secret), tidak boleh masuk bundel browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Koneksi Supabase untuk halaman admin (aman terlihat browser, dilindungi RLS).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ID Pixel Meta. Kosongkan jika tidak memakai Pixel. Jika kosong, tidak ada skrip Meta dimuat.
PUBLIC_META_PIXEL_ID=

# Membuka atau menutup pendaftaran. true untuk buka, false untuk tutup.
REGISTRATION_OPEN=true

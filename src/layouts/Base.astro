---
import '../styles/global.css';
import '../../tailwind.css';
import FloatingNav from '../components/FloatingNav.astro';

// Meta dari docs/CONTENT.md bagian "Teks meta".
const title = 'Open House';
const description =
  'Datang, lihat langsung, dan coba sendiri. Daftar hadir open house SMKIT As Syifa Boarding School, Jalancagak, Subang.';

interface Props {
  title?: string;
  description?: string;
  adminMode?: boolean;
  landing?: boolean;
}

const {
  title: pageTitle,
  description: pageDescription,
  adminMode = false,
  landing = false,
} = Astro.props;
const finalTitle = pageTitle ? `${pageTitle} - Open House SMKIT As Syifa` : title;
const finalDescription = pageDescription ?? description;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription} />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <meta name="og:title" content={title} />
    <meta name="og:description" content={finalDescription} />
    <meta name="og:type" content="website" />
    <slot name="head" />

<!-- Meta Pixel Code -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1683289080083380');
    fbq('track', 'PageView');
  </script>
  <noscript>
    <img height="1" width="1" style="display:none"
         src="https://www.facebook.com/tr?id=1683289080083380&ev=PageView&noscript=1" />
  </noscript>
  <!-- End Meta Pixel Code -->
  
  </head>
  <body class:list={[{ 'admin-page': adminMode, 'landing-page': landing }]}>
    <FloatingNav adminMode={adminMode} variant={landing ? 'landing' : 'default'} />
    <slot />
    <script is:inline>
      // Tangkap parameter UTM/fbclid dari URL dan simpan di sessionStorage
      // saat halaman pertama dimuat. Tidak menimpa nilai yang sudah tersimpan.
      (function capture() {
        try {
          var keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid'];
          var params = new URLSearchParams(window.location.search);
          for (var i = 0; i < keys.length; i += 1) {
            var key = keys[i];
            if (window.sessionStorage.getItem(key)) continue;
            var val = params.get(key);
            if (val) window.sessionStorage.setItem(key, val);
          }
        } catch (e) {
          /* storage tidak tersedia; abaikan */
        }
      })();
    </script>
  </body>
</html>
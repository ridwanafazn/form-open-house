---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StorySection from '../components/StorySection';
import VisitorGuide from '../components/VisitorGuide.astro';
import AddCalendar from '../components/AddCalendar';
// Form kini tanpa pemeriksaan CAPTCHA (Turnstile). Jebakan bot tetap ada di
// form lewat isian tersembunyi (honeypot), ditangani di sisi server.
import RegisterForm from '../components/RegisterForm';
import { content } from '../config/content';
import { eventConfig } from '../config/event';
import 'leaflet/dist/leaflet.css';

const [dayName, ...dateParts] = eventConfig.dateText.split(', ');
const dateOnly = dateParts.join(', ');
---

<Base landing>
  <main>
    <Hero />

    <section class="section" id="story" aria-labelledby="story-title">
      <div class="container">
        <header class="section-head">
          <h2 id="story-title">Apa yang bisa dilihat dan dicoba</h2>
        </header>
        <!-- StorySection sudah di-SSR Astro, jadi konten tampil tanpa JS.
             Tidak ada lagi salinan statis terpisah: dahulu dua daftar (statis
             + island) ikut ter-render sehingga nomor 01-04 muncul dua kali
             dan salinan kedua baru muncul saat island terhidrasi. -->
        <StorySection client:visible />
      </div>
    </section>

    <section class="campus-band" aria-labelledby="campus-band-title">
      <div class="container">
        <figure class="campus-band__figure">
          <img
            src="/images/hero/upacara.jpg"
            alt="Upacara bendera di halaman sekolah"
            width="1200"
            height="675"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="campus-band__caption">
            <h2 class="campus-band__kicker" id="campus-band-title">{content.home.campusBand.kicker}</h2>
            <p class="campus-band__text">{content.home.campusBand.text}</p>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="section section--card" id="incentiv" aria-labelledby="incentiv-title">
      <div class="container">
        <header class="section-head">
          <h2 id="incentiv-title">{content.home.incentive.heading}</h2>
        </header>

        <div class="price-grid">
          <div class="price-card">
            <p class="price-card__label">Pendaftaran normal</p>
            <p class="price-card__amount price-card__amount--muted">Rp500<span>ribu</span></p>
            <p class="price-card__note">Di luar open house</p>
          </div>
          <div class="price-card price-card--teal">
            <p class="price-card__label">Daftar saat open house</p>
            <p class="price-card__amount">Rp100<span>ribu</span></p>
            <p class="price-card__note">Hemat Rp400 ribu</p>
          </div>
          <div class="price-card price-card--gold">
            <p class="price-card__label">Daftar belakangan</p>
            <p class="price-card__amount">Rp300<span>ribu</span></p>
            <p class="price-card__note">{content.home.incentive.laterNote}</p>
          </div>
        </div>
        <p class="incentive-note">{content.home.incentive.note}</p>
      </div>
    </section>

    <section class="section" id="event-info" aria-labelledby="event-info-title">
      <div class="container">
        <header class="section-head">
          <h2 id="event-info-title">{content.home.eventInfo.heading}</h2>
        </header>

        <div class="info-grid">
          <div class="info-panel">
            <ul class="info-list">
              <li>
                <strong>Jam</strong>
                <span class="info-value">{eventConfig.startTime} sampai {eventConfig.endTime} WIB</span>
              </li>
              <li><strong>Hari</strong> <span class="info-value">{dayName}</span></li>
              <li><strong>Tanggal</strong> <span class="info-value">{dateOnly}</span></li>
              <li><strong>Tempat</strong> <span class="info-value">{eventConfig.locationName}</span></li>
              <li><strong>Alamat</strong> <span class="info-value">{eventConfig.locationAddress}</span></li>
            </ul>
            <div class="info-actions">
              <a class="button button--primary" href={eventConfig.mapsUrl} rel="noopener" target="_blank">{content.home.eventInfo.openMap}</a>
              <AddCalendar client:visible />
            </div>
          </div>
          <div class="map-card">
            <div id="map" class="map-card__canvas" role="application" aria-label={`Peta lokasi ${eventConfig.locationName}`}></div>
            <noscript>
              <p class="map-card__fallback">
                Peta tidak dapat dimuat tanpa JavaScript.
                <a href={eventConfig.mapsUrl} rel="noopener" target="_blank">Buka di Google Maps</a>.
              </p>
            </noscript>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--card" id="rundown" aria-labelledby="rundown-title">
      <div class="container">
        <header class="section-head">
          <h2 id="rundown-title">{content.home.rundown.heading}</h2>
          <p class="section-head__tagline">{content.home.rundown.tagline}</p>
        </header>
        <div class="rundown" data-rundown>
          <div class="rundown-tabs" role="tablist" aria-label="Pilih sesi susunan acara">
            {content.home.rundown.groups.map((group, groupIndex) => (
              <button
                type="button"
                role="tab"
                id={`rundown-tab-${groupIndex}`}
                aria-controls={`rundown-panel-${groupIndex}`}
                aria-selected={groupIndex === 0 ? 'true' : 'false'}
                tabindex={groupIndex === 0 ? 0 : -1}
                class:list={['rundown-tab', groupIndex === 0 && 'is-active']}
              >
                <span class="rundown-tab__title">{group.short ?? group.title}</span>
              </button>
            ))}
          </div>

          <div class="rundown-panels">
            {content.home.rundown.groups.map((group, groupIndex) => (
              <section
                class:list={['rundown-panel', groupIndex === 0 && 'is-active']}
                id={`rundown-panel-${groupIndex}`}
                role="tabpanel"
                aria-labelledby={`rundown-tab-${groupIndex}`}
                tabindex="0"
              >
                <header class="rundown-panel__head">
                  <h3 class="rundown-panel__title">{group.title}</h3>
                  <p class="rundown-panel__range">{group.range}</p>
                </header>
                <ol class="rundown-panel__items" role="list">
                  {group.items.map((item) => (
                    <li class="rundown-item">
                      <span class="rundown-time">{item.time}</span>
                      <div class="rundown-content">
                        <h4 class="rundown-item-title">{item.title}</h4>
                        <span class="rundown-location">{item.location}</span>
                      </div>
                    </li>
                  ))}
                </ol>
              </section>
            ))}
          </div>
        </div>
      </div>
    </section>

    <VisitorGuide />

    <section class="section" id="form" aria-labelledby="form-title">
      <div class="container form-wrap">
        <header class="section-head">
          <h2 id="form-title">{content.home.form.heading}</h2>
          <p class="section-head__tagline">{content.home.form.tagline}</p>
        </header>
        <RegisterForm client:only="react" />
      </div>
    </section>

    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__grid">
          <div class="site-footer__brand">
            <img class="site-footer__logo" src="/images/logo.png" alt="Logo SMKIT As-Syifa" width="40" height="40" />
            <div>
              <p class="site-footer__eyebrow">SMKIT As-Syifa Boarding School</p>
              <p class="site-footer__text">{content.home.footer.text}</p>
            </div>
          </div>
          <nav class="site-footer__col" aria-label="Tautan footer">
            <p class="site-footer__title">Tautan</p>
            <a href="/#event-info">Info Acara</a>
            <a href="/#rundown">Rundown</a>
            <a href="/#panduan">Panduan</a>
            <a href="/#form">Daftar Hadir</a>
          </nav>
          <div class="site-footer__col">
            <p class="site-footer__title">Kontak</p>
            <a
              class="site-footer__contact"
              href={`https://wa.me/${eventConfig.admissionWhatsApp}`}
              rel="noopener"
              target="_blank"
            >Admisi {eventConfig.admissionWhatsApp.replace(/^62/, '0')}</a>
          </div>
        </div>
        <div class="site-footer__bottom">
          <p>&copy; 2026 SMKIT As-Syifa Boarding School</p>
          <a href="/privasi">Kebijakan privasi</a>
        </div>
      </div>
    </footer>
  </main>

  <a class="sticky-cta" href="#form">{content.home.hero.cta}</a>
</Base>

<script>
  // Peta Leaflet: inisialisasi langsung begitu halaman terbuka. Versi lama
  // menunggu IntersectionObserver dan di sebagian lingkungan pengamat tidak
  // pernah memicu sehingga peta tampil kosong (0 tile). Muatan tile kecil,
  // jadi inisialisasi dini tidak memberatkan.
  import L from 'leaflet';
  import { eventConfig } from '../config/event';

  const container = document.getElementById('map');
  if (container && !container.classList.contains('leaflet-container')) {
    const map = L.map(container, {
      scrollWheelZoom: false,
      attributionControl: true,
    }).setView([eventConfig.mapsLat, eventConfig.mapsLng], 14);

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);

    const marker = L.circleMarker([eventConfig.mapsLat, eventConfig.mapsLng], {
      radius: 10,
      color: '#0f6f6a',
      weight: 3,
      fillColor: '#1b9a94',
      fillOpacity: 1,
    }).addTo(map);

    marker.bindPopup(`<strong>${eventConfig.locationName}</strong>`, {
      // Popup ringkas: tetap terbuka otomatis, tetapi tidak memenuhi peta.
      maxWidth: 210,
      autoPanPaddingTopLeft: [12, 48],
      autoPanPaddingBottomRight: [12, 12],
      className: 'map-popup',
    });
    // Popup dibuka otomatis di semua ukuran layar; di mobile ukurannya dibuat
    // lebih kecil lewat CSS agar tidak menempel ke tepi atau terpotong.
    marker.openPopup();

    // Pastikan ukuran peta benar setelah layout selesai dan saat viewport
    // berubah (rotasi ponsel, panel admin terbuka, dsb.).
    const fit = () => map.invalidateSize();
    setTimeout(fit, 0);
    window.addEventListener('resize', fit);
  }
</script>

<script>
  // Tab susunan acara. Tanpa JavaScript semua panel tetap tampil; kelas
  // data-enhanced baru menyembunyikan panel nonaktif setelah tab siap.
  const rundown = document.querySelector('[data-rundown]');
  if (rundown) {
    rundown.setAttribute('data-enhanced', '');
    const tabs = Array.from(rundown.querySelectorAll('[role="tab"]'));
    const panels = Array.from(rundown.querySelectorAll('[role="tabpanel"]'));

    const activate = (index) => {
      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel, panelIndex) => {
        panel.classList.toggle('is-active', panelIndex === index);
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') next = 0;
        if (event.key === 'End') next = tabs.length - 1;
        activate(next);
        tabs[next].focus();
      });
    });
  }
</script>

<script>
  // Tombol menempel di bagian bawah layar HP setelah hero lewat,
  // dan hilang saat form terlihat.
  const cta = document.querySelector('.sticky-cta');
  const hero = document.getElementById('hero');
  const form = document.getElementById('form');
  if (cta && hero && form) {
    // Simpan status terakhir tiap elemen. Callback IntersectionObserver bisa
    // hanya membawa satu entri; memakai entries.find untuk keduanya membuat
    // tombol muncul kembali saat hero masih terlihat.
    let heroIn = true;
    let formIn = false;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.target === hero) heroIn = entry.isIntersecting;
          if (entry.target === form) formIn = entry.isIntersecting;
        }
        if (formIn || heroIn) {
          cta.classList.add('is-hidden');
        } else {
          cta.classList.remove('is-hidden');
        }
      },
      { threshold: 0 },
    );
    io.observe(hero);
    io.observe(form);
  }
</script>

<style>
  .section {
    padding-block: var(--space-12);
  }

  /* Kepala bagian. */
  .section-head {
    max-width: 640px;
    margin: 0 auto var(--space-8);
    text-align: center;
  }

  .section-head h2 {
    margin-top: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    text-transform: none;
  }

  .section-head__tagline {
    margin-top: var(--space-3);
    color: var(--ink-soft);
  }

  /* Bagian bergaris atas-bawah dan latar kartu: memberi ritme antar-bagian. */
  .section--card {
    border-block: 1px solid var(--paper-grid);
    background: var(--paper-card);
  }

  /* --- Adegan cerita: panel kartu matte, baris bernomor konsisten --- */
  :global(.story-list) {
    display: flex;
    flex-direction: column;
    max-width: 820px;
    margin-inline: auto;
    padding: var(--space-2);
    border: 1px solid var(--paper-grid);
    border-radius: var(--radius-card);
    background: #ffffff;
  }

  :global(.story-scene) {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--space-4) var(--space-6);
    align-items: start;
    padding: var(--space-6);
  }

  :global(.story-scene + .story-scene) {
    border-top: 1px solid var(--paper-grid);
  }

  :global(.story-scene__num) {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
    color: var(--teal-dark);
  }

  :global(.story-scene__heading) {
    margin: 0 0 var(--space-2);
    font-size: clamp(1.2rem, 3vw, 1.5rem);
  }

  :global(.story-scene__text) {
    max-width: 52ch;
    margin: 0;
    color: var(--ink-soft);
    font-size: 1rem;
  }

  @media (min-width: 720px) {
    :global(.story-scene) {
      grid-template-columns: 5rem 1fr;
      gap: var(--space-6);
      padding: var(--space-8);
    }
  }

  /* --- Suasana sekolah: band foto lebar dengan panel teks matte --- */
  .campus-band {
    padding-block: 0 var(--space-8);
  }

  .campus-band__figure {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--paper-grid);
    border-radius: var(--radius-card);
    background: var(--ink);
  }

  .campus-band__figure img {
    width: 100%;
    height: clamp(260px, 42vw, 460px);
    object-fit: cover;
    object-position: center 42%;
  }

  .campus-band__caption {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    max-width: 420px;
    padding: var(--space-4) var(--space-6);
    border: 1px solid rgba(244, 239, 228, 0.22);
    border-radius: var(--radius-control);
    background: var(--ink);
    color: var(--paper);
  }

  .campus-band__kicker {
    margin: 0 0 var(--space-2);
    color: var(--gold);
    font-family: var(--font-tech);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .campus-band__text {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .campus-band__figure img {
      height: 300px;
    }

    .campus-band__caption {
      position: static;
      max-width: none;
      border: 0;
      border-top: 1px solid rgba(244, 239, 228, 0.22);
      border-radius: 0;
    }
  }

  /* --- Kartu insentif --- */
  .price-grid {
    display: grid;
    gap: var(--space-4);
    max-width: 920px;
    margin-inline: auto;
  }

  @media (min-width: 760px) {
    .price-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .price-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px solid var(--paper-grid);
    border-radius: 16px;
    background: #ffffff;
  }

  .price-card__label {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .price-card__amount {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
  }

  .price-card__amount span {
    margin-left: 0.2em;
    font-size: 0.45em;
  }

  .price-card__amount--muted {
    color: var(--ink-soft);
    text-decoration: line-through;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--maroon);
  }

  .price-card__note {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  /* Kartu utama: bidang teal penuh, teks putih — satu-satunya blok tebal. */
  .price-card--teal {
    border-color: var(--teal-dark);
    background: var(--teal-dark);
  }

  .price-card--teal .price-card__label,
  .price-card--teal .price-card__amount,
  .price-card--teal .price-card__note {
    color: #ffffff;
  }

  .price-card--teal .price-card__note {
    opacity: 0.85;
  }

  .price-card--gold {
    border-color: var(--gold);
    background: #f3e5c8;
  }

  /* Catatan biaya seleksi: Space Grotesk 14px bold, garis bawah dibuat
     berjarak supaya tidak menyentuh huruf (seperti anotasi kecil). */
  .incentive-note {
    width: fit-content;
    max-width: 100%;
    margin: var(--space-6) auto 0;
    color: var(--ink);
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.6;
    text-align: center;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-decoration-color: var(--teal-dark);
    text-underline-offset: 8px;
  }

  /* --- Info acara + peta --- */
  .info-grid {
    display: grid;
    gap: var(--space-4);
    align-items: stretch;
  }

  @media (min-width: 900px) {
    .info-grid {
      /* Dua kolom seimbang: informasi dan peta punya bobot visual sama. */
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .info-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: clamp(20px, 3vw, 32px);
    border: 1px solid var(--paper-grid);
    border-radius: 16px;
    background: #ffffff;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .info-list li {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--paper-grid);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .info-list li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  @media (min-width: 560px) {
    .info-list li {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: var(--space-4);
      align-items: start;
    }
  }

  .info-list strong {
    color: var(--teal-dark);
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .info-value {
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.6;
  }

  .info-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: auto;
  }

  @media (min-width: 480px) {
    .info-actions {
      flex-direction: row;
    }
  }

  .info-actions .button {
    flex: 1 1 0;
    min-width: 0;
    border-radius: 10px;
    white-space: nowrap;
  }

  .map-card {
    display: flex;
    padding: 6px;
    overflow: hidden;
    border: 1px solid var(--ink);
    border-radius: 16px;
    background: #ffffff;
    /* Outline peta: garis tinta + cincin tipis + bayangan lembut. */
    box-shadow:
      0 0 0 4px var(--paper-card),
      0 0 0 5px var(--paper-grid),
      0 18px 36px rgba(34, 38, 42, 0.16);
  }

  .map-card__canvas {
    width: 100%;
    min-height: 340px;
    height: clamp(340px, 44vw, 480px);
    border-radius: 10px;
    /* Nuansa tenang: sedikit didesaturasi supaya menyatu dengan tema kertas. */
    filter: grayscale(0.25) saturate(0.85);
  }

  .map-card__fallback {
    padding: var(--space-4);
    color: var(--ink-soft);
  }

  /* Kontrol Leaflet diselaraskan dengan tema (tetap datar). */
  .map-card :global(.leaflet-control-attribution) {
    font-size: 0.62rem;
    background: rgba(250, 246, 236, 0.85);
    color: var(--ink-soft);
  }

  .map-card :global(.leaflet-popup-content-wrapper) {
    border-radius: 10px;
    color: var(--ink);
    font-family: var(--font-body);
  }

  .map-card :global(.map-popup .leaflet-popup-content) {
    margin: 7px 10px;
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .map-card :global(.map-popup .leaflet-popup-content strong) {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .map-card {
      box-shadow:
        0 0 0 3px var(--paper-card),
        0 0 0 4px var(--paper-grid),
        0 12px 24px rgba(34, 38, 42, 0.14);
    }


---
import { eventConfig } from '../config/event';
import { content } from '../config/content';

const hero = content.home.hero;
const words = hero.title.split(' ');
---

<section class="hero" id="hero">
  <div class="container hero__inner">
    <h1 class="hero__title">
      {words.map((word) => <span>{word}</span>)}
    </h1>

    <p class="hero__tagline">{hero.tagline}</p>

    <div class="hero__cards">
      <div class="hero-card">
        <span class="hero-card__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
        </span>
        <span class="hero-card__text">
          <strong>{eventConfig.dateText}</strong>
          <small>{eventConfig.startTime} - {eventConfig.endTime} WIB</small>
        </span>
      </div>
      <div class="hero-card">
        <span class="hero-card__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        </span>
        <span class="hero-card__text">
          <strong>Jalancagak, Subang</strong>
          <small>SMKIT As Syifa Boarding School</small>
        </span>
      </div>
    </div>

    <a class="button button--primary hero__cta" href="#form">{hero.cta}</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(620px, calc(100vh - 88px));
    padding-block: clamp(64px, 10vw, 110px);
    text-align: center;
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .hero__title {
    max-width: 18ch;
    margin: 0 auto;
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 8vw, 4.6rem);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-transform: none;
  }

  .hero__title span {
    display: inline-block;
    margin-inline: 0.12em;
  }

  .hero__tagline {
    max-width: 36ch;
    margin: var(--space-4) auto 0;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
  }

  .hero__cards {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  /* Kartu info ala referensi: tile ikon + judul + keterangan, matte. */
  .hero-card {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: 14px 22px 14px 14px;
    border: 1px solid var(--paper-grid);
    border-radius: var(--radius-card);
    background: #ffffff;
    text-align: left;
  }

  .hero-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-control);
    background: var(--paper);
    color: var(--teal-dark);
    flex: none;
  }

  .hero-card__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero-card__text strong {
    font-family: var(--font-heading);
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--ink);
  }

  .hero-card__text small {
    color: var(--ink-soft);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero__cta {
    min-width: min(320px, 100%);
    margin-top: var(--space-8);
    padding-inline: var(--space-8);
    min-height: 54px;
  }

  @media (max-width: 640px) {
    .hero__cards {
      flex-direction: column;
      align-items: stretch;
      max-width: 360px;
      margin-inline: auto;
    }
  }
</style>

---
import { content } from '../config/content';
import { BASE_GROUP_CODES, groupRoutes, tourSessions } from '../config/groups';

const tour = content.home.rundown.tour;
---

<section class="tour-guide" id="alur-kelompok" aria-labelledby="tour-guide-title">
  <header class="tour-guide__head">
    <p class="tour-guide__kicker">Tour kampus</p>
    <h3 id="tour-guide-title">{tour.heading}</h3>
    <p class="tour-guide__lead">{tour.tagline}</p>
    <div class="tour-guide__meta" aria-label="Durasi tour">
      <span>{tour.durationLabel}</span>
      <span>{tour.durationText}</span>
    </div>
  </header>

  <div class="tour-guide__block">
    <h4>{tour.sessionsHeading}</h4>
    <div class="tour-table-wrap">
      <table class="tour-table">
        <thead>
          <tr>
            <th scope="col">Sesi</th>
            <th scope="col">Waktu</th>
            {BASE_GROUP_CODES.map((code) => (
              <th scope="col">Kelompok {code}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {tourSessions.map((session) => (
            <tr>
              <th scope="row">Sesi {session.number}</th>
              <td>{session.time}</td>
              {BASE_GROUP_CODES.map((code) => (
                <td>{session.locations[code]}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="tour-table-hint">Geser tabel ke samping untuk melihat semua kelompok.</p>
    <p class="tour-manual-note">{tour.manualNote}</p>
  </div>

  <div class="tour-guide__block">
    <h4>{tour.routesHeading}</h4>
    <div class="tour-routes">
      {groupRoutes.map((route) => (
        <article class:list={['tour-route', `tour-route--${route.code.toLowerCase()}`]}>
          <header class="tour-route__head">
            <span class="tour-route__code" aria-hidden="true">{route.code}</span>
            <h5>{route.label}</h5>
          </header>
          <ol class="tour-route__stops">
            {route.stops.map((stop) => (
              <li>{stop}</li>
            ))}
            {route.returnStop && <li class="tour-route__return">Kembali ke {route.returnStop}</li>}
          </ol>
          <p class="tour-route__note">{route.note}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="tour-guide__foot">
    <div>
      <h4>{tour.finalHeading}</h4>
      <p>{tour.finalText}</p>
    </div>
    <div>
      <h4>{tour.notesHeading}</h4>
      <ul class="tour-guide__notes">
        {tour.notes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </div>
  </div>

  <a class="tour-guide__link" href="/kelompok">
    <span>{tour.groupLinkLabel}</span>
    <small>{tour.groupLinkNote}</small>
  </a>
</section>

<style>
  .tour-guide {
    max-width: 1080px;
    margin: var(--space-6) auto 0;
    padding: var(--space-4);
    border: 1px solid var(--paper-grid);
    border-radius: 16px;
    background: #ffffff;
  }

  .tour-guide__head {
    padding: 0 var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--paper-grid);
  }

  .tour-guide__kicker {
    margin: 0;
    color: var(--teal-dark);
    font-family: var(--font-tech);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tour-guide h3,
  .tour-guide h4,
  .tour-guide h5 {
    margin: 0;
    font-family: var(--font-heading);
  }

  .tour-guide h3 {
    margin-top: var(--space-2);
    font-size: clamp(1.15rem, 3vw, 1.45rem);
    line-height: 1.2;
  }

  .tour-guide h4 {
    margin-bottom: var(--space-3);
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .tour-guide__lead {
    max-width: 62ch;
    margin: var(--space-2) 0 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .tour-guide__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .tour-guide__meta span {
    padding: 3px 8px;
    border: 1px solid var(--paper-grid);
    border-radius: 4px;
    background: var(--paper-card);
    color: var(--ink);
    font-family: var(--font-tech);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .tour-guide__block {
    padding: var(--space-4) var(--space-2);
    border-bottom: 1px solid var(--paper-grid);
  }

  .tour-table-wrap {
    overflow-x: auto;
  }

  .tour-table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 0.82rem;
  }

  .tour-table th,
  .tour-table td {
    padding: 9px 10px;
    border: 1px solid var(--paper-grid);
    text-align: left;
    vertical-align: top;
  }

  .tour-table thead th {
    background: var(--paper-card);
    color: var(--ink-soft);
    font-family: var(--font-tech);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .tour-table tbody th {
    background: var(--paper-card);
    font-family: var(--font-heading);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .tour-table tbody td {
    color: var(--ink);
  }

  .tour-table-hint {
    display: none;
    margin: var(--space-2) 0 0;
    color: var(--ink-soft);
    font-size: 0.7rem;
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .tour-table-hint {
      display: block;
    }
  }

  .tour-manual-note {
    margin: var(--space-3) 0 0;
    padding: 8px 10px;
    border-left: 3px solid var(--teal-dark);
    background: var(--paper-card);
    color: var(--ink-soft);
    font-size: 0.74rem;
    line-height: 1.45;
  }

  .tour-routes {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 720px) {
    .tour-routes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .tour-route {
    padding: var(--space-3);
    border: 1px solid var(--paper-grid);
    border-radius: 10px;
    background: var(--paper-card);
  }

  .tour-route__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .tour-route__code {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex: none;
    border-radius: 6px;
    background: var(--ink);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .tour-route h5 {
    font-size: 0.9rem;
    line-height: 1.2;
  }

  .tour-route__stops {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: stop;
  }

  .tour-route__stops li {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: 8px;
    align-items: start;
    color: var(--ink);
    font-size: 0.82rem;
    line-height: 1.4;
    counter-increment: stop;
  }

  .tour-route__stops li::before {
    content: counter(stop);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border: 1px solid var(--paper-grid);
    border-radius: 50%;
    background: #ffffff;
    color: var(--ink-soft);
    font-family: var(--font-tech);
    font-size: 0.6rem;
    font-weight: 700;
  }

  .tour-route__stops .tour-route__return {
    color: var(--teal-dark);
    font-weight: 700;
  }

  .tour-route__note {
    margin: var(--space-3) 0 0;
    padding-top: var(--space-2);
    border-top: 1px dashed var(--paper-grid);
    color: var(--ink-soft);
    font-size: 0.74rem;
    line-height: 1.45;
  }

  .tour-guide__foot {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-2);
    border-bottom: 1px solid var(--paper-grid);
  }

  @media (min-width: 720px) {
    .tour-guide__foot {
      grid-template-columns: 1fr 1fr;
    }
  }

  .tour-guide__foot p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .tour-guide__notes {
    display: grid;
    gap: 6px;
    margin: 0;
    padding-left: 18px;
    color: var(--ink-soft);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .tour-guide__link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px var(--space-3);
    margin-top: var(--space-4);
    padding: 12px 14px;
    border: 1px solid var(--ink);
    border-radius: 6px;
    background: var(--ink);
    color: #ffffff;
    text-decoration: none;
  }

  .tour-guide__link span {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .tour-guide__link small {
    color: var(--paper);
    font-size: 0.74rem;
  }

  .tour-guide__link:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  @media (max-width: 520px) {
    .tour-guide {
      padding: var(--space-3);
    }

    .tour-guide__block {
      padding-inline: 0;
    }

    .tour-guide__foot {
      padding-inline: 0;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import ThankYouSummary from '../components/ThankYouSummary';
import TicketCard from '../components/TicketCard';
import AddCalendar from '../components/AddCalendar';
import { eventConfig } from '../config/event';
import { content } from '../config/content';

const isGroup = eventConfig.waJoinKind === 'group';
const waNote = isGroup
  ? content.thankyou.nextSteps.waGroupNote
  : content.thankyou.nextSteps.waChannelNote;
const waJoinHref = eventConfig.waJoinUrl?.startsWith('http') ? eventConfig.waJoinUrl : null;
const chatAdmisi = `https://wa.me/${eventConfig.admissionWhatsApp}?text=${encodeURIComponent(
  'Assalamualaikum. Saya ingin bertanya tentang Open House SMKIT As Syifa.',
)}`;
---

<Base title="Terima kasih" description="Pendaftaran open house berhasil dikirim.">
  <meta slot="head" name="robots" content="noindex" />
  <main class="container">
    <section class="ty" aria-labelledby="ty-title">
      <header class="ty__head">
        <h1 id="ty-title">{content.thankyou.title}</h1>
      </header>
      <ThankYouSummary client:idle />

      <!-- Kartu Tiket Masuk Digital & QR Code -->
      <TicketCard client:load />

      <p class="ty__note">{content.thankyou.note}</p>

      {waJoinHref && (
        <div class="ty__block">
          <h2 class="ty__sub">Sebelum hari acara</h2>
          <a class="button button--primary" href={waJoinHref} rel="noopener" target="_blank">
            {content.thankyou.nextSteps.joinWa}
          </a>
          <p class="ty__wa-note">{waNote}</p>
        </div>
      )}

      <div class="ty__block">
        <h2 class="ty__sub">Simpan dan siapkan</h2>
        <div class="ty__actions">
          <AddCalendar client:idle />
          <a class="button button--secondary" href={chatAdmisi} rel="noopener" target="_blank">
            {content.thankyou.nextSteps.chatAdmisi}
          </a>
          <a class="button button--secondary" href={eventConfig.pmbPortalUrl} rel="noopener" target="_blank">
            {content.thankyou.nextSteps.pmbLink}
          </a>
        </div>
      </div>

      <p class="ty__back"><a href="/">Kembali ke halaman utama</a></p>
    </section>
  </main>
</Base>

<style>
  .ty {
    max-width: 640px;
    margin-inline: auto;
    padding-block: var(--space-12) var(--space-16);
  }
  .ty__head {
    margin-bottom: var(--space-6);
  }
  .ty__head h1 {
    margin-top: var(--space-2);
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }
  .ty__note {
    color: var(--ink-soft);
    margin-block: var(--space-6) var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--paper-grid);
  }
  .ty__block {
    margin-block: var(--space-6);
  }
  .ty__sub {
    font-size: 1.05rem;
    margin-bottom: var(--space-3);
    color: var(--ink);
  }
  .ty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }
  .ty__wa-note {
    margin-top: var(--space-2);
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .ty__back {
    margin-top: var(--space-8);
    font-size: 0.9rem;
  }
</style>

---
import Base from '../../layouts/Base.astro';
import PublicTicket from '../../components/PublicTicket';
export const prerender = false;

const code = Astro.params.code ?? '';
---

<Base title={`Tiket ${code}`} description="Tiket digital Open House SMKIT As-Syifa Boarding School.">
  <meta slot="head" name="robots" content="noindex" />
  <main class="ticket-page">
    <div class="container">
      <div class="ticket-page__inner">
        <PublicTicket client:load code={code} />
        <p class="ticket-page__footnote">
          Tiket ini untuk keperluan registrasi Open House. Simpan tautan ini sampai hari acara.
        </p>
        <p class="ticket-page__back">
          <a href="/">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 12H5"></path>
              <path d="m12 19-7-7 7-7"></path>
            </svg>
            Kembali ke halaman utama
          </a>
        </p>
      </div>
    </div>
  </main>
</Base>

<style>
  .ticket-page {
    padding-block: var(--space-8) var(--space-16);
  }

  .ticket-page__inner {
    max-width: 620px;
    margin-inline: auto;
  }

  .ticket-page__footnote {
    margin-top: var(--space-3);
    color: var(--ink-soft);
    font-size: 0.8rem;
    line-height: 1.5;
    text-align: center;
  }

  .ticket-page__back {
    margin-top: var(--space-6);
    font-size: 0.9rem;
    text-align: center;
  }

  .ticket-page__back a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-soft);
    font-weight: 600;
    text-decoration: none;
  }

  .ticket-page__back a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>

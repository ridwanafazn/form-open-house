---
import { eventConfig } from '../config/event';

const admissionHref = `https://wa.me/${eventConfig.admissionWhatsApp}?text=${encodeURIComponent(
  'Assalamualaikum. Saya ingin bertanya tentang Open House SMKIT As Syifa.',
)}`;

interface Props {
  adminMode?: boolean;
}

const { adminMode = false } = Astro.props;
---

<nav class:list={['floating-nav', { 'floating-nav--admin': adminMode }]} aria-label={adminMode ? 'Navigasi admin' : 'Navigasi utama'}>
  <div class="floating-nav__container">
    <a class="floating-nav__brand" href={adminMode ? '/admin' : '/'} aria-label={adminMode ? 'Halaman admin' : 'Beranda Open House SMKIT As Syifa'}>
      <img class="floating-nav__logo" src="/images/logo.png" alt="Logo SMKIT As Syifa" width="32" height="32" />
      <span class="floating-nav__brand-text">{adminMode ? 'Admin Portal' : 'Open House As Syifa'}</span>
    </a>

    <button class="floating-nav__toggle" type="button" aria-expanded="false" aria-controls="floating-nav-links" aria-label="Toggle Menu">
      <span class="floating-nav__toggle-lines" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    <div class="floating-nav__links" id="floating-nav-links">
      {adminMode ? (
        <>
          <a href="#dashboard" class="floating-nav__link">Dashboard</a>
          <a href="#scan" class="floating-nav__link">Scan Presensi</a>
          <a href="/" class="floating-nav__link">Lihat Situs</a>
          <div class="floating-nav__user-group" id="admin-nav-user" hidden>
            <div class="floating-nav__user">
              <img class="floating-nav__avatar" id="admin-nav-avatar" src="" alt="Avatar" width="26" height="26" />
              <span class="floating-nav__user-name" id="admin-nav-name"></span>
            </div>
          </div>
          <button type="button" class="floating-nav__logout" id="admin-nav-logout">Keluar</button>
        </>
      ) : (
        <>
          <a href="/#event-info" class="floating-nav__link">Info Acara</a>
          <a href="/#rundown" class="floating-nav__link">Rundown</a>
          <a class="floating-nav__link floating-nav__admission" href={admissionHref} rel="noopener" target="_blank">
            <span>Admisi</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </>
      )}
    </div>
  </div>
</nav>

<script>
  const nav = document.querySelector('.floating-nav');
  const toggle = nav?.querySelector('.floating-nav__toggle');
  const links = nav?.querySelector('.floating-nav__links');

  if (nav && toggle && links) {
    const closeMenu = () => {
      nav.classList.remove('floating-nav--open');
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('floating-nav--open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    links.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 768) closeMenu();
    });
  }

  document
    .getElementById('admin-nav-logout')
    ?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('admin-logout'));
    });
</script>

<style>
  .floating-nav {
    position: fixed;
    z-index: 50;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: min(calc(100% - 32px), 1024px);
    background: rgba(248, 245, 238, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(183, 214, 207, 0.4);
    border-radius: 9999px;
    box-shadow: 0 12px 40px -10px rgba(15, 111, 106, 0.08), 0 2px 6px rgba(0, 0, 0, 0.03);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .floating-nav__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px 8px 12px;
    min-height: 52px;
    gap: 16px;
  }

  .floating-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink, #22262a);
    font-family: var(--font-heading, Georgia, serif);
    font-weight: 700;
    font-size: 0.92rem;
    letter-spacing: -0.01em;
    transition: opacity 0.2s ease;
  }

  .floating-nav__brand:hover {
    opacity: 0.8;
  }

  .floating-nav__logo {
    width: 32px;
    height: 32px;
    object-fit: contain;
    border-radius: 8px;
  }

  .floating-nav__links {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .floating-nav__link {
    text-decoration: none;
    padding: 7px 14px;
    border-radius: 9999px;
    color: var(--ink-soft, #5b6068);
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: 0.84rem;
    font-weight: 600;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .floating-nav__link:hover,
  .floating-nav__link:focus-visible {
    background: rgba(27, 154, 148, 0.1);
    color: var(--teal-dark, #0f6f6a);
  }

  .floating-nav__admission {
    background: var(--teal-dark, #0f6f6a);
    color: #ffffff !important;
    box-shadow: 0 4px 12px rgba(15, 111, 106, 0.25);
  }

  .floating-nav__admission:hover {
    background: var(--teal, #1b9a94) !important;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(27, 154, 148, 0.35);
  }

  .floating-nav__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(183, 214, 207, 0.5);
    border-radius: 50%;
    background: transparent;
    color: var(--ink, #22262a);
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .floating-nav__toggle:hover {
    background: rgba(0, 0, 0, 0.04);
  }

  .floating-nav__toggle-lines {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 16px;
  }

  .floating-nav__toggle-lines span {
    display: block;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  }

  /* Admin specific styling */
  .floating-nav--admin {
    background: rgba(237, 243, 247, 0.85);
    border-color: rgba(185, 201, 216, 0.5);
  }

  .floating-nav__user-group {
    display: inline-flex;
    align-items: center;
  }

  .floating-nav__user {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 3px 12px 3px 4px;
    border: 1px solid rgba(185, 201, 216, 0.6);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.6);
  }

  .floating-nav__avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    object-fit: cover;
  }

  .floating-nav__user-name {
    max-width: 130px;
    overflow: hidden;
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .floating-nav__logout {
    padding: 6px 14px;
    border: 1px solid rgba(163, 32, 32, 0.3);
    border-radius: 9999px;
    background: transparent;
    color: var(--error, #a32020);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .floating-nav__logout:hover {
    background: var(--error);
    color: #ffffff;
    border-color: var(--error);
  }

  /* Responsive / Mobile styles */
  @media (max-width: 768px) {
    .floating-nav {
      top: 12px;
      width: calc(100% - 24px);
      border-radius: 20px;
    }

    .floating-nav__container {
      padding: 8px 12px;
    }

    .floating-nav__toggle {
      display: inline-flex;
    }

    .floating-nav__links {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
      padding: 0;
      max-height: 0;
      overflow: hidden;
      background: rgba(248, 245, 238, 0.95);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(183, 214, 207, 0);
      border-radius: 16px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .floating-nav--open .floating-nav__links {
      max-height: 400px;
      padding: 12px;
      border-color: rgba(183, 214, 207, 0.5);
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .floating-nav__link {
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 0.9rem;
    }

    .floating-nav__user-group {
      width: 100%;
    }

    .floating-nav__user {
      width: 100%;
      padding: 6px 12px 6px 6px;
      border-radius: 10px;
    }

    .floating-nav__logout {
      width: 100%;
      text-align: center;
      padding: 10px;
      border-radius: 10px;
    }

    /* Hamburger animation */
    .floating-nav--open .floating-nav__toggle-lines span:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }

    .floating-nav--open .floating-nav__toggle-lines span:nth-child(2) {
      opacity: 0;
    }

    .floating-nav--open .floating-nav__toggle-lines span:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }
  }
</style>
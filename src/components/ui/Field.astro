---
// Isian bergaris bawah di atas kertas, seperti menulis di garis buku. Label di atas isian.
interface Props {
  label: string;
  id: string;
  name: string;
  type?: string;
  value?: string;
  placeholder?: string;
  helperText?: string;
  error?: string;
  required?: boolean;
  autocomplete?: string;
  inputmode?: string;
  class?: string;
  maxlength?: number;
}

const {
  label,
  id,
  name,
  type = 'text',
  value,
  placeholder,
  helperText,
  error,
  required = false,
  autocomplete,
  inputmode,
  class: className = '',
  maxlength,
} = Astro.props;

const classes = ['field', className].filter(Boolean).join(' ');
const invalid = error ? ' true' : undefined;
---

<div class={classes}>
  <label class="field__label" for={id}>
    {label}
    {required && <span class="field__req" aria-hidden="true">*</span>}
  </label>
  <input
    class="field__input"
    id={id}
    name={name}
    type={type}
    value={value}
    placeholder={placeholder}
    autocomplete={autocomplete}
    inputmode={inputmode}
    maxlength={maxlength}
    aria-required={required}
    aria-invalid={invalid}
    aria-describedby={helperText ? `${id}-help` : error ? `${id}-error` : undefined}
  />
  {helperText && !error && <p class="field__help" id="{id}-help">{helperText}</p>}
  {error && (
    <p class="field__error" id="{id}-error">
      {error}
    </p>
  )}
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .field__label {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1rem;
    color: var(--ink);
  }

  .field__req {
    color: var(--maroon);
  }

  .field__input {
    width: 100%;
    min-height: 44px;
    padding: var(--space-2) 0;
    border: 0;
    border-bottom: var(--line) solid var(--ink);
    background: transparent;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.4;
    border-radius: 0;
  }

  .field__input::placeholder {
    color: var(--ink-soft);
    opacity: 1;
  }

  .field__input:focus {
    outline: none;
    border-bottom-color: var(--teal-dark);
  }

  .field__help {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .field__error {
    font-size: 0.9rem;
    color: var(--error);
  }
</style>

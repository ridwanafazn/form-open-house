---
import Base from '../layouts/Base.astro';
import { content } from '../config/content';
import { eventConfig } from '../config/event';

const p = content.privacy;
const deleteWa = `https://wa.me/${eventConfig.admissionWhatsApp}?text=${encodeURIComponent(
  'Assalamualaikum. Saya ingin meminta penghapusan data pendaftaran Open House.',
)}`;
---

<Base
  title="Kebijakan Privasi"
  description="Data apa yang dicatat saat mendaftar Open House SMKIT As-Syifa, cara penggunaannya, dan cara meminta penghapusan."
>
  <main class="privacy">
    <div class="container">
      <header class="privacy-hero">
        <p class="privacy-kicker">{p.kicker}</p>
        <h1>{p.title}</h1>
        <p class="privacy-lead">{p.lead}</p>
        <p class="privacy-meta">{p.meta}</p>
      </header>

      <div class="privacy-grid">
        <section class="privacy-card privacy-card--data" aria-labelledby="data-title">
          <h2 class="privacy-card__title" id="data-title">{p.collectedHeading}</h2>
          <p class="privacy-card__intro">{p.collectedIntro}</p>
          <ul class="privacy-chips">
            {p.dataItems.map((item) => (
              <li class="privacy-chip">{item}</li>
            ))}
          </ul>
        </section>

        <section class="privacy-card" aria-labelledby="usage-title">
          <h2 class="privacy-card__title" id="usage-title">{p.usageHeading}</h2>
          <dl class="privacy-facts">
            <div class="privacy-fact">
              <dt>{p.purposeLabel}</dt>
              <dd>{p.purposeText}</dd>
            </div>
            <div class="privacy-fact">
              <dt>{p.accessLabel}</dt>
              <dd>{p.accessText}</dd>
            </div>
            <div class="privacy-fact">
              <dt>{p.retentionLabel}</dt>
              <dd>{p.retentionText}</dd>
            </div>
          </dl>
        </section>

        <section
          class="privacy-card privacy-card--sharing"
          aria-labelledby="sharing-title"
        >
          <h2 class="privacy-card__title" id="sharing-title">{p.sharingHeading}</h2>
          <p class="privacy-card__text">{p.sharingText}</p>
        </section>

        <section class="privacy-card privacy-card--delete" aria-labelledby="delete-title">
          <div>
            <h2 class="privacy-card__title" id="delete-title">{p.deletionHeading}</h2>
            <p class="privacy-card__text">{p.deletionText}</p>
            <p class="privacy-delete__note">{p.deleteRequest}</p>
          </div>
          <a
            class="button button--primary privacy-delete__action"
            href={deleteWa}
            rel="noopener noreferrer"
            target="_blank"
          >
            {p.deletionAction}
          </a>
        </section>
      </div>

      <p class="privacy-back">
        <a href="/">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M19 12H5"></path>
            <path d="m12 19-7-7 7-7"></path>
          </svg>
          Kembali ke halaman utama
        </a>
      </p>
    </div>
  </main>
</Base>

<style>
  .privacy {
    padding-block: var(--space-8) var(--space-16);
  }

  /* --- Kepala halaman --- */
  .privacy-hero {
    max-width: 680px;
    margin-bottom: var(--space-8);
  }

  .privacy-kicker {
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 3px 8px;
    border: 1px solid var(--teal-dark);
    border-radius: 4px;
    background: var(--teal-pale);
    color: var(--teal-dark);
    font-family: var(--font-tech);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.7;
    text-transform: uppercase;
  }

  .privacy-hero h1 {
    margin-top: var(--space-4);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.8rem, 4.6vw, 2.6rem);
    line-height: 1.15;
  }

  .privacy-lead {
    max-width: 58ch;
    margin-top: var(--space-3);
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.6;
  }

  .privacy-meta {
    margin-top: var(--space-4);
    color: var(--ink-soft);
    font-family: var(--font-tech);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  /* --- Kartu isi: satu kolom di mobile, dua kolom seimbang di desktop --- */
  .privacy-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 860px) {
    .privacy-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }

    .privacy-card--delete {
      grid-column: 1 / -1;
    }

    .privacy-card--sharing {
      grid-column: 1 / -1;
    }
  }

  .privacy-card {
    padding: var(--space-6);
    border: 1px solid var(--paper-grid);
    border-radius: 12px;
    background: #ffffff;
  }

  .privacy-card--data {
    background: var(--paper-card);
  }

  /* Pernyataan pembagian data: pita ringkas selebar grid. */
  .privacy-card--sharing {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: var(--teal-pale);
    border-color: #b9d6d1;
  }

  .privacy-card--sharing .privacy-card__title {
    margin-bottom: 0;
  }

  .privacy-card--sharing .privacy-card__text {
    color: var(--ink);
  }

  @media (min-width: 760px) {
    .privacy-card--sharing {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-8);
    }

    .privacy-card--sharing .privacy-card__text {
      max-width: 52ch;
      text-align: right;
    }
  }

  .privacy-card__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .privacy-card__intro {
    margin-bottom: var(--space-4);
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .privacy-card__text {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /* --- Daftar data: chip persegi, bukan pil --- */
  .privacy-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .privacy-chip {
    padding: 4px 9px;
    border: 1px solid var(--paper-grid);
    border-radius: 2px;
    background: #ffffff;
    color: var(--ink);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  /* --- Fakta penggunaan --- */
  .privacy-facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
  }

  .privacy-fact {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--paper-grid);
  }

  .privacy-fact:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .privacy-fact dt {
    color: var(--teal-dark);
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.7;
    text-transform: uppercase;
  }

  .privacy-fact dd {
    margin: 1px 0 0;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  /* --- Penghapusan data --- */
  .privacy-card--delete {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border-left: 3px solid var(--maroon);
    background: var(--paper-card);
  }

  .privacy-card--delete .privacy-card__text {
    max-width: 58ch;
  }

  .privacy-delete__note {
    margin-top: var(--space-2);
    color: var(--ink-soft);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .privacy-delete__action {
    width: 100%;
  }

  @media (min-width: 640px) {
    .privacy-card--delete {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-6);
    }

    .privacy-delete__action {
      flex: none;
      width: auto;
    }
  }

  /* --- Kembali --- */
  .privacy-back {
    margin-top: var(--space-8);
    font-size: 0.9rem;
    text-align: center;
  }

  .privacy-back a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-soft);
    font-weight: 600;
    text-decoration: none;
  }

  .privacy-back a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  @media (max-width: 599px) {
    .privacy-card {
      padding: var(--space-4);
    }
  }
</style>
